@model List<SmartPOS.Domain.Entities.Organization.Counter>
@{
    ViewData["Title"] = "Counter Management - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var branches = ViewBag.Branches as List<SmartPOS.Domain.Entities.Organization.Branch> ?? new();
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-display text-emerald me-2"></i> POS Counters</h2>
            <p class="text-muted small mb-0">Configure cashier checkouts, hardware profiles, and thermal printer assignments.</p>
        </div>
        <button type="button" class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#newCounterModal">
            <i class="bi bi-plus-lg me-1"></i> Add Counter
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Counter Name</th>
                        <th>Code</th>
                        <th>Branch</th>
                        <th>Printer Device</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">No counters registered yet.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold text-light">@c.Name</td>
                            <td><span class="badge bg-surface border border-subtle mono">@c.Code</span></td>
                            <td class="text-light">@(c.Branch?.Name ?? "Main Branch")</td>
                            <td class="text-muted small"><i class="bi bi-printer me-1 text-emerald"></i> @(c.PrinterName ?? "Default Thermal 80mm")</td>
                            <td>
                                <span class="badge @(c.Status == "Active" ? "bg-emerald-subtle text-emerald" : "bg-danger-subtle text-danger")">
                                    @c.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Counter -->
<div class="modal fade" id="newCounterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Register New POS Counter</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Branch Outlet</label>
                        <select name="branchId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.Name (@b.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Counter Name</label>
                            <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Express Checkout 02" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Counter Code</label>
                            <input type="text" name="code" class="form-control bg-surface border-subtle text-light" placeholder="e.g. CTR-02" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Thermal Printer Model</label>
                        <input type="text" name="printerName" class="form-control bg-surface border-subtle text-light" value="Default Thermal 80mm" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Save Counter</button>
                </div>
            </form>
        </div>
    </div>
</div>
