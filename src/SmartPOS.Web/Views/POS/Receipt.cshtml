@model SmartPOS.Domain.Entities.Sales.POSOrder
@{
    Layout = null;
    var business = ViewBag.Business as SmartPOS.Domain.Entities.Organization.Business;
    var currency = business?.CurrencyCode ?? "PKR";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt - @Model.InvoiceNo</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            color: #000;
            background: #fff;
            margin: 0;
            padding: 10px;
        }

        .receipt-container {
            width: 80mm;
            margin: 0 auto;
            padding: 5px;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .text-left { text-align: left; }
        .fw-bold { font-weight: bold; }
        .text-uppercase { text-transform: uppercase; }

        .header-title {
            font-size: 18px;
            font-weight: 900;
            margin-bottom: 2px;
            letter-spacing: -0.5px;
        }

        .divider {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }

        .divider-double {
            border-top: 2px dashed #000;
            margin: 8px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        th, td {
            padding: 3px 0;
            vertical-align: top;
        }

        .no-print {
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-print {
            background-color: #16856B;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }

        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; margin: 0; }
            .receipt-container { width: 100%; margin: 0; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="btn-print" onclick="window.print()">Print Receipt [Ctrl+P]</button>
    </div>

    <div class="receipt-container">
        <!-- Store Header -->
        <div class="text-center">
            <div class="header-title">@(business?.Name ?? "SMARTPOS ENTERPRISE")</div>
            <div>@(Model.Branch?.Name ?? "Main Outlet")</div>
            <div>@(Model.Branch?.Address ?? business?.Address ?? "Retail Plaza, Commercial Market")</div>
            <div>Tel: @(Model.Branch?.Contact ?? business?.Phone ?? "+92 300 0000000")</div>
            @if (!string.IsNullOrEmpty(business?.TaxRegistrationNumber))
            {
                <div>NTN / STRN: @business.TaxRegistrationNumber</div>
            }
        </div>

        <div class="divider"></div>

        <!-- Transaction Details -->
        <div>
            <div><strong>Invoice:</strong> @Model.InvoiceNo</div>
            <div><strong>Date/Time:</strong> @Model.CreatedAtUtc.ToString("dd-MMM-yyyy HH:mm:ss")</div>
            <div><strong>Counter:</strong> @(Model.Counter?.Name ?? "Counter 01")</div>
            <div><strong>Customer:</strong> @(Model.Customer?.Name ?? "Walk-in Retail Customer")</div>
            @if (!string.IsNullOrEmpty(Model.FbrInvoiceNo))
            {
                <div><strong>FBR Inv:</strong> @Model.FbrInvoiceNo</div>
            }
        </div>

        <div class="divider"></div>

        <!-- Line Items -->
        <table>
            <thead>
                <tr>
                    <th class="text-left" style="width: 50%;">Item</th>
                    <th class="text-center" style="width: 15%;">Qty</th>
                    <th class="text-right" style="width: 15%;">Price</th>
                    <th class="text-right" style="width: 20%;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-left">
                            <div class="fw-bold">@(item.Product?.Name ?? "Product Item")</div>
                        </td>
                        <td class="text-center">@item.Qty.ToString("G29")</td>
                        <td class="text-right">@item.PriceSnapshot.ToString("N0")</td>
                        <td class="text-right fw-bold">@item.LineTotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="divider"></div>

        <!-- Financial Summary -->
        <table>
            <tr>
                <td class="text-left">Subtotal:</td>
                <td class="text-right">@currency @Model.Subtotal.ToString("N2")</td>
            </tr>
            @if (Model.DiscountTotal > 0)
            {
                <tr>
                    <td class="text-left">Discount:</td>
                    <td class="text-right">- @currency @Model.DiscountTotal.ToString("N2")</td>
                </tr>
            }
            <tr>
                <td class="text-left">Tax (Included):</td>
                <td class="text-right">@currency @Model.TaxTotal.ToString("N2")</td>
            </tr>
            <tr style="font-size: 15px; font-weight: bold;">
                <td class="text-left">TOTAL:</td>
                <td class="text-right">@currency @Model.Total.ToString("N2")</td>
            </tr>
            <tr class="divider"></tr>
            <tr>
                <td class="text-left">Cash Tendered:</td>
                <td class="text-right">@currency @Model.PaidAmount.ToString("N2")</td>
            </tr>
            <tr>
                <td class="text-left">Change Returned:</td>
                <td class="text-right">@currency @Model.ChangeAmount.ToString("N2")</td>
            </tr>
        </table>

        <!-- Payment Breakdown -->
        <div class="divider"></div>
        <div>
            @foreach (var pay in Model.Payments)
            {
                <div><strong>Paid via:</strong> @(pay.PaymentMethod?.Name ?? "Cash") - @currency @pay.Amount.ToString("N2")</div>
            }
        </div>

        <!-- Footer Notice -->
        <div class="divider-double"></div>
        <div class="text-center" style="font-size: 11px;">
            <div class="fw-bold">THANK YOU FOR YOUR PATRONAGE!</div>
            <div>Exchange possible within 7 days with original receipt.</div>
            <div>Powered by SMARTPOS ENTERPRISE Cloud</div>
        </div>
    </div>

    <script>
        // Auto-print if query string contains autoPrint=true
        if (window.location.search.includes('autoPrint=true')) {
            window.print();
        }
    </script>
</body>
</html>
