@model List<SmartPOS.Domain.Entities.Finance.Expense>
@{
    ViewData["Title"] = "Expense Management - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var categories = ViewBag.Categories as List<SmartPOS.Domain.Entities.Finance.ExpenseCategory> ?? new();
    var branches = ViewBag.Branches as List<SmartPOS.Domain.Entities.Organization.Branch> ?? new();
    var currency = ViewBag.Currency as string ?? "PKR";
    var totalExpenses = (decimal)ViewBag.TotalExpenses;
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-wallet2 text-emerald me-2"></i> Operational Expenses</h2>
            <p class="text-muted small mb-0">Record daily till expenses, branch utilities, maintenance, and petty cash logs.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
                <i class="bi bi-plus-lg me-1"></i> Add Expense
            </button>
            <button class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                <i class="bi bi-tag me-1"></i> New Category
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Stat Card -->
    <div class="card-stat p-3 mb-4">
        <span class="text-muted small text-uppercase fw-semibold">Total Expenses (Current Filter)</span>
        <div class="fs-3 fw-bold text-danger mono">@currency @totalExpenses.ToString("N2")</div>
    </div>

    <!-- Expenses Table -->
    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Branch</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Description / Note</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">No expenses recorded yet.</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="text-muted small">@e.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-surface border border-subtle text-light">@(e.Category?.Name ?? "General Expense")</span></td>
                            <td class="text-secondary small">@(e.Branch?.Name ?? "Main Outlet")</td>
                            <td class="fw-bold text-danger mono">@currency @e.Amount.ToString("N2")</td>
                            <td class="text-muted small">@e.PaymentMethod</td>
                            <td class="text-light small">@(e.Description ?? "-")</td>
                            <td><span class="badge bg-emerald-subtle text-emerald border border-emerald">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Expense -->
<div class="modal fade" id="newExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Record Operational Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Expense Category</label>
                        <select name="categoryId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Branch</label>
                        <select name="branchId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Amount (@currency)</label>
                        <input type="number" step="0.01" name="amount" class="form-control bg-surface border-subtle text-light mono fs-4 fw-bold" placeholder="0.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Description / Remarks</label>
                        <input type="text" name="description" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Utility bill, office tea, packaging supplies" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: New Expense Category -->
<div class="modal fade" id="newCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Add Expense Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Category Name</label>
                        <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Electricity, Maintenance, Rent" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Description</label>
                        <input type="text" name="description" class="form-control bg-surface border-subtle text-light" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
