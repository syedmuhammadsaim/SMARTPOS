@model List<SmartPOS.Domain.Entities.Organization.Branch>
@{
    ViewData["Title"] = "Branch Management - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-shop text-emerald me-2"></i> Branches & Outlets</h2>
            <p class="text-muted small mb-0">Manage operating retail locations, default invoice prefixes, and staff assignments.</p>
        </div>
        <button type="button" class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#newBranchModal">
            <i class="bi bi-plus-lg me-1"></i> Add Branch
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Branch Name</th>
                        <th>Code</th>
                        <th>Prefix</th>
                        <th>Counters</th>
                        <th>Contact</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-5">No branches found.</td></tr>
                    }
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="fw-bold text-light">@b.Name</td>
                            <td><span class="badge bg-surface border border-subtle mono">@b.Code</span></td>
                            <td><span class="badge bg-emerald-subtle text-emerald mono">@b.InvoicePrefix</span></td>
                            <td><span class="badge bg-surface border border-subtle">@b.Counters.Count Counters</span></td>
                            <td class="small text-secondary">@(b.Contact ?? "-")</td>
                            <td class="small text-muted">@(b.Address ?? "-")</td>
                            <td>
                                <span class="badge @(b.Status == "Active" ? "bg-emerald-subtle text-emerald" : "bg-danger-subtle text-danger")">
                                    @b.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleStatus" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light border-subtle btn-sm px-2 py-1 rounded">
                                        @(b.Status == "Active" ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Branch -->
<div class="modal fade" id="newBranchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Register New Store Branch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Branch Name</label>
                        <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Gulberg Outlet" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Branch Code</label>
                            <input type="text" name="code" class="form-control bg-surface border-subtle text-light" placeholder="e.g. BR-02" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Invoice Prefix</label>
                            <input type="text" name="invoicePrefix" class="form-control bg-surface border-subtle text-light" placeholder="e.g. GLB" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Contact Phone</label>
                        <input type="text" name="contact" class="form-control bg-surface border-subtle text-light" placeholder="+92 300 0000000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Address / Location</label>
                        <textarea name="address" class="form-control bg-surface border-subtle text-light" rows="2" placeholder="Market, street address, city"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Save Branch</button>
                </div>
            </form>
        </div>
    </div>
</div>
