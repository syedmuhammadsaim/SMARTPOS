@{
    ViewData["Title"] = "SaaS Licensing & Machine Nodes";
    var sub = ViewBag.Subscription as SmartPOS.Application.Features.Licensing.DTOs.SubscriptionStatusDto;
    var licenses = ViewBag.Licenses as List<SmartPOS.Domain.Entities.System.LicenseKey> ?? new();
    var devices = ViewBag.Devices as List<SmartPOS.Domain.Entities.System.DeviceRegistration> ?? new();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-white">SaaS Subscriptions & Hardware Security</h2>
            <span class="badge-pill-modern badge-indigo">
                <i class="bi bi-shield-check"></i> Machine Bound
            </span>
        </div>
        <p class="text-secondary mb-0">Hardware fingerprint licensing, multi-branch terminal quotas, and offline grace keys</p>
    </div>
    <button class="btn btn-modern-primary d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newKeyModal">
        <i class="bi bi-key-fill"></i> Issue License Key
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert glass-card border-success text-emerald mb-4 d-flex align-items-center gap-2 p-3">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Quota & Subscription Status Cards -->
@if (sub != null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Current Plan</span>
                    <div class="kpi-icon-box" style="background: rgba(99, 102, 241, 0.15); color: #818CF8; border: 1px solid rgba(99, 102, 241, 0.3);">
                        <i class="bi bi-gem"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-white mono mb-1">@sub.Plan</div>
                <div class="text-secondary small">
                    <span class="badge-pill-modern @(sub.Status == "Active" ? "badge-emerald" : (sub.Status == "GracePeriod" ? "badge-amber" : "badge-rose"))">
                        @sub.Status
                    </span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Branch Quota</span>
                    <div class="kpi-icon-box" style="background: rgba(6, 182, 212, 0.15); color: #06B6D4; border: 1px solid rgba(6, 182, 212, 0.3);">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-cyan mono mb-1">@sub.CurrentBranchesCount / @sub.MaxBranches</div>
                <div class="text-secondary small">Allocated enterprise branches</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">POS Counter Nodes</span>
                    <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-display"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-amber mono mb-1">@sub.CurrentCountersCount / @sub.MaxCounters</div>
                <div class="text-secondary small">Active billing counter terminals</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Subscription Period</span>
                    <div class="kpi-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-white mono mb-1">@sub.EndDate.ToString("dd MMM yyyy")</div>
                <div class="text-secondary small">
                    @if (sub.IsInGracePeriod)
                    {
                        <span class="text-amber fw-bold"><i class="bi bi-clock me-1"></i> @sub.GracePeriodDaysRemaining days grace</span>
                    }
                    else
                    {
                        <span class="text-emerald"><i class="bi bi-shield-check me-1"></i> Verified & Active</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Active License Keys Table -->
    <div class="col-lg-7">
        <div class="glass-card h-100">
            <div class="glass-card-header">
                <div>
                    <h5 class="fw-bold mb-1 text-white">
                        <i class="bi bi-key-fill text-indigo me-2"></i>Authorized Enterprise Keys
                    </h5>
                    <p class="text-secondary small mb-0">Cryptographically signed machine activation tokens</p>
                </div>
                <span class="badge-pill-modern badge-indigo">@licenses.Count Key(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>License Key</th>
                            <th class="text-center">Device Limit</th>
                            <th class="text-center">Expiry Date</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (licenses.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">No license keys generated yet.</td></tr>
                        }
                        @foreach (var l in licenses)
                        {
                            var isExpired = l.ExpiresAt < DateTime.UtcNow;
                            <tr>
                                <td><span class="badge-pill-modern badge-cyan mono fs-6">@l.Key</span></td>
                                <td class="text-center"><span class="badge-pill-modern badge-indigo mono">@l.DeviceLimit Nodes</span></td>
                                <td class="text-center mono small">@l.ExpiresAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    @if (isExpired)
                                    {
                                        <span class="badge-pill-modern badge-rose">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill-modern badge-emerald">Active</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Registered Hardware Terminals -->
    <div class="col-lg-5">
        <div class="glass-card h-100">
            <div class="glass-card-header">
                <div>
                    <h5 class="fw-bold mb-1 text-white">
                        <i class="bi bi-cpu text-emerald me-2"></i>Bound Hardware Nodes
                    </h5>
                    <p class="text-secondary small mb-0">Registered desktop tills & peripherals</p>
                </div>
                <span class="badge-pill-modern badge-emerald">@devices.Count Active</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Device Fingerprint</th>
                            <th>Printer / Peripheral</th>
                            <th class="text-end">Last Seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (devices.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-secondary py-4">No terminals active yet.</td></tr>
                        }
                        @foreach (var d in devices)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-white mono">@d.DeviceId</div>
                                    <div class="small text-secondary">Scanner: @d.ScannerSuffix</div>
                                </td>
                                <td>
                                    <span class="badge-pill-modern badge-indigo">@(d.PrinterName ?? "POS-80 Thermal")</span>
                                </td>
                                <td class="text-end mono small text-secondary">
                                    @d.LastSeenUtc.ToString("HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal for issuing new key -->
<div class="modal fade" id="newKeyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-accent); color: var(--text-primary);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-subtle);">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-key-fill text-indigo me-2"></i> Issue New Machine Key</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GenerateKey" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Plan Tier</label>
                        <select name="plan" class="form-select bg-dark text-white border-secondary">
                            <option value="Starter">Starter (2 Terminals)</option>
                            <option value="Professional">Professional (10 Terminals)</option>
                            <option value="Enterprise" selected>Enterprise (Unlimited / 50 Terminals)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Device Limit</label>
                        <input type="number" name="deviceLimit" value="10" min="1" max="100" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-semibold">Validity (Days)</label>
                        <input type="number" name="validityDays" value="365" min="30" max="1825" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-subtle);">
                    <button type="button" class="btn btn-modern-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-modern-primary"><i class="bi bi-check-lg me-1"></i> Generate & Issue</button>
                </div>
            </form>
        </div>
    </div>
</div>
