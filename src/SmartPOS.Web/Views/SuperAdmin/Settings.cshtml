@model List<SmartPOS.Domain.Entities.SaaS.PlatformSetting>
@{
    ViewData["Title"] = "Platform Settings - Super Admin";
    Layout = "_Layout";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-sliders text-emerald me-2"></i> Platform Settings</h2>
            <p class="text-muted small mb-0">Global parameters, default currency, brand identity, and support channels.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card bg-card border-subtle rounded-4 p-4">
                <h5 class="fw-bold text-light mb-4 pb-2 border-bottom border-subtle">Global Configuration Variables</h5>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Setting Key</th>
                                <th>Current Value</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th class="text-end">Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-emerald mono">@s.Key</td>
                                    <td>
                                        <form asp-action="SaveSetting" method="post" class="d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="key" value="@s.Key" />
                                            <input type="hidden" name="category" value="@s.Category" />
                                            <input type="hidden" name="description" value="@s.Description" />
                                            <input type="text" name="value" value="@s.Value" class="form-control form-control-sm bg-surface border-subtle text-light" style="min-width: 160px;" />
                                            <button type="submit" class="btn btn-emerald btn-sm px-2 py-1"><i class="bi bi-save"></i></button>
                                        </form>
                                    </td>
                                    <td><span class="badge bg-surface border border-subtle">@s.Category</span></td>
                                    <td class="text-muted small">@s.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-card border-subtle rounded-4 p-4">
                <h5 class="fw-bold text-light mb-3 pb-2 border-bottom border-subtle">Add Custom Platform Setting</h5>
                <form asp-action="SaveSetting" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Setting Key</label>
                        <input type="text" name="key" class="form-control bg-surface border-subtle text-light" placeholder="Platform:CustomKey" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Value</label>
                        <input type="text" name="value" class="form-control bg-surface border-subtle text-light" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Category</label>
                        <select name="category" class="form-select bg-surface border-subtle text-light">
                            <option value="General">General</option>
                            <option value="Billing">Billing</option>
                            <option value="Security">Security</option>
                            <option value="Notification">Notification</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Description</label>
                        <input type="text" name="description" class="form-control bg-surface border-subtle text-light" />
                    </div>
                    <button type="submit" class="btn btn-emerald w-100 fw-semibold rounded-3 py-2">
                        <i class="bi bi-plus-lg me-1"></i> Save Platform Setting
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
