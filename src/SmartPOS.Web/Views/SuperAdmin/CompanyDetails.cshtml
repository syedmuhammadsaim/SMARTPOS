@model SmartPOS.Web.Models.CompanyDetailsViewModel
@{
    ViewData["Title"] = $"Company - {Model.Company.Name}";
    Layout = "_Layout";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Companies" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Companies</a>
                <span class="text-muted small">/ Details</span>
            </div>
            <h2 class="fw-bold text-white mb-0">@Model.Company.Name</h2>
        </div>
        <div class="d-flex gap-2">
            <form asp-action="ToggleCompanyStatus" asp-route-id="@Model.Company.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                @if (Model.Company.Status == "Active")
                {
                    <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-3" onclick="return confirm('Are you sure you want to suspend this company? Users will be blocked from logging in.');">
                        <i class="bi bi-pause-circle me-1"></i> Suspend Company
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold">
                        <i class="bi bi-play-circle me-1"></i> Reactivate Company
                    </button>
                }
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Stat overview cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card-stat p-3">
                <div class="text-muted small">Subscription Plan</div>
                <div class="fs-4 fw-bold text-emerald">@(Model.Plan?.Name ?? "Trial / Custom")</div>
                <div class="text-muted small">Expires: @(Model.Company.SubscriptionExpiresAtUtc?.ToString("dd MMM yyyy") ?? "N/A")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-stat p-3">
                <div class="text-muted small">Branches & Counters</div>
                <div class="fs-4 fw-bold text-light">@Model.Branches.Count Branches / @Model.Counters.Count Counters</div>
                <div class="text-muted small">Quota: @(Model.Plan?.MaxBranches.ToString() ?? "Unlimited") Br / @(Model.Plan?.MaxCounters.ToString() ?? "Unlimited") Ctr</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-stat p-3">
                <div class="text-muted small">Total Sales Volume</div>
                <div class="fs-4 fw-bold text-light">@Model.Company.CurrencyCode @Model.TotalSalesAmount.ToString("N0")</div>
                <div class="text-muted small">@Model.TotalSalesCount Completed Transactions</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-stat p-3">
                <div class="text-muted small">Catalog Inventory</div>
                <div class="fs-4 fw-bold text-light">@Model.TotalProductsCount Products</div>
                <div class="text-muted small">Live catalog items</div>
            </div>
        </div>
    </div>

    <!-- Details Sections -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card bg-card border-subtle rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-light mb-3 pb-2 border-bottom border-subtle">
                    <i class="bi bi-shop me-2 text-emerald"></i> Operating Branches
                </h5>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Branch Name</th>
                                <th>Code</th>
                                <th>Contact</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Branches.Any())
                            {
                                <tr><td colspan="4" class="text-muted text-center py-3">No branches created yet.</td></tr>
                            }
                            @foreach (var b in Model.Branches)
                            {
                                <tr>
                                    <td class="fw-semibold text-light">@b.Name</td>
                                    <td><span class="badge bg-surface border border-subtle mono">@b.Code</span></td>
                                    <td class="text-muted small">@b.Contact</td>
                                    <td><span class="badge bg-emerald-subtle text-emerald">@b.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bg-card border-subtle rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-light mb-3 pb-2 border-bottom border-subtle">
                    <i class="bi bi-people me-2 text-emerald"></i> Authorized Staff Users
                </h5>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Users.Any())
                            {
                                <tr><td colspan="3" class="text-muted text-center py-3">No users assigned.</td></tr>
                            }
                            @foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td class="fw-semibold text-light">@u.FullName</td>
                                    <td class="text-muted small">@u.Email</td>
                                    <td>
                                        <span class="badge @(u.IsActive ? "bg-emerald-subtle text-emerald" : "bg-danger-subtle text-danger")">
                                            @(u.IsActive ? "Active" : "Disabled")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
