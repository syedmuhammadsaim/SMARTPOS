@model List<SmartPOS.Domain.Entities.Identity.AuditLog>
@{
    ViewData["Title"] = "Platform Audit Trail - Super Admin";
    Layout = "_Layout";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-journal-text text-emerald me-2"></i> Platform Audit Trail</h2>
            <p class="text-muted small mb-0">Auditable security events, tenant status changes, and administrative actions.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Overview
        </a>
    </div>

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>Old Value</th>
                        <th>New Value</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">No audit records logged yet.</td></tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-muted small">@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-emerald-subtle text-emerald border border-emerald mono">@log.Action</span></td>
                            <td class="fw-semibold text-light">@log.Entity</td>
                            <td><span class="badge bg-surface border border-subtle mono">@log.EntityId</span></td>
                            <td class="text-muted small">@(log.OldValues ?? "-")</td>
                            <td class="text-light small">@(log.NewValues ?? "-")</td>
                            <td class="text-muted small">@(log.IpAddress ?? "Localhost")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
