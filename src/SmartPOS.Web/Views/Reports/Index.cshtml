@{
    ViewData["Title"] = "Executive Reports & Analytics";
    var pnl = ViewBag.Pnl as SmartPOS.Application.Features.Reports.DTOs.ProfitAndLossReportDto;
    var categories = ViewBag.Categories as List<SmartPOS.Application.Features.Reports.DTOs.SalesByCategoryReportDto> ?? new();
    var paymentMethods = ViewBag.PaymentMethods as List<SmartPOS.Application.Features.Reports.DTOs.SalesByPaymentMethodReportDto> ?? new();
    var cashiers = ViewBag.Cashiers as List<SmartPOS.Application.Features.Reports.DTOs.CashierPerformanceReportDto> ?? new();
    var valuation = ViewBag.Valuation as SmartPOS.Application.Features.Reports.DTOs.InventoryValuationReportDto;
}

<!-- Page Header & Filter Form -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-white">Executive Financials & P&L</h2>
            <span class="badge-pill-modern badge-indigo">
                <i class="bi bi-bar-chart-fill"></i> Real-time Ledger
            </span>
        </div>
        <p class="text-secondary mb-0">Perpetual COGS, gross margins, operating expenses, and cashier leaderboards</p>
    </div>
    <form method="get" class="d-flex flex-wrap align-items-center gap-2">
        <div class="input-group input-group-sm" style="width: auto;">
            <span class="input-group-text bg-dark text-secondary border-secondary">From</span>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm bg-dark text-white border-secondary" />
        </div>
        <div class="input-group input-group-sm" style="width: auto;">
            <span class="input-group-text bg-dark text-secondary border-secondary">To</span>
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm bg-dark text-white border-secondary" />
        </div>
        <button type="submit" class="btn btn-modern-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-filter"></i> Apply Filter
        </button>
    </form>
</div>

<!-- Profit & Loss Summary Cards -->
@if (pnl != null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Gross Revenue</span>
                    <div class="kpi-icon-box" style="background: rgba(22, 133, 107, 0.15); color: #16856B; border: 1px solid rgba(22, 133, 107, 0.3);">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-white mono mb-1">Rs. @pnl.GrossSalesRevenue.ToString("N0")</div>
                <div class="text-secondary small">
                    <span class="badge-pill-modern badge-indigo py-0 px-2">@pnl.TotalInvoicesCount Invoices</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Discounts & Returns</span>
                    <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-arrow-return-left"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-amber mono mb-1">Rs. @((pnl.TotalDiscounts + pnl.TotalReturnsRefunded).ToString("N0"))</div>
                <div class="text-secondary small">
                    Disc: Rs. @pnl.TotalDiscounts.ToString("N0") | Ret: Rs. @pnl.TotalReturnsRefunded.ToString("N0")
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Gross Profit (Margin)</span>
                    <div class="kpi-icon-box" style="background: rgba(22, 133, 107, 0.15); color: #16856B; border: 1px solid rgba(22, 133, 107, 0.3);">
                        <i class="bi bi-graph-up"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-cyan mono mb-1">Rs. @pnl.GrossProfit.ToString("N0")</div>
                <div class="text-secondary small">
                    Margin: <span class="badge-pill-modern badge-cyan py-0 px-2">@pnl.GrossProfitMarginPercent%</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-secondary text-uppercase small fw-bold">Net Profit</span>
                    <div class="kpi-icon-box" style="background: rgba(22, 133, 107, 0.15); color: #16856B; border: 1px solid rgba(22, 133, 107, 0.3);">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-emerald mono mb-1">Rs. @pnl.NetProfit.ToString("N0")</div>
                <div class="text-secondary small">
                    OpEx: Rs. @pnl.TotalOperatingExpenses.ToString("N0")
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Category Sales Breakdown -->
    <div class="col-lg-6">
        <div class="glass-card h-100">
            <div class="glass-card-header">
                <div>
                    <h5 class="fw-bold mb-1 text-white">
                        <i class="bi bi-pie-chart text-indigo me-2"></i>Sales by Category
                    </h5>
                    <p class="text-secondary small mb-0">Departmental contribution to total turnover</p>
                </div>
                <span class="badge-pill-modern badge-indigo">@categories.Count Categories</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Revenue</th>
                            <th class="text-end">Gross Profit</th>
                            <th class="text-end">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (categories.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">No category sales recorded in this date range.</td></tr>
                        }
                        @foreach (var cat in categories)
                        {
                            <tr>
                                <td class="fw-semibold text-white">@cat.CategoryName</td>
                                <td class="text-end mono">Rs. @cat.TotalRevenue.ToString("N2")</td>
                                <td class="text-end text-emerald mono">Rs. @cat.GrossProfit.ToString("N2")</td>
                                <td class="text-end"><span class="badge-pill-modern badge-cyan">@cat.RevenueSharePercent%</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Payment Methods Breakdown -->
    <div class="col-lg-6">
        <div class="glass-card h-100">
            <div class="glass-card-header">
                <div>
                    <h5 class="fw-bold mb-1 text-white">
                        <i class="bi bi-credit-card-2-front text-emerald me-2"></i>Tender / Payment Mix
                    </h5>
                    <p class="text-secondary small mb-0">Cash vs 1Link / PayPak / Cards vs Customer Udhaar</p>
                </div>
                <span class="badge-pill-modern badge-emerald">Payment Gateways</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th class="text-center">Transactions</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (paymentMethods.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">No payments recorded in this period.</td></tr>
                        }
                        @foreach (var pm in paymentMethods)
                        {
                            <tr>
                                <td class="fw-semibold text-white">@pm.PaymentMethod</td>
                                <td class="text-center mono text-secondary">@pm.TransactionCount</td>
                                <td class="text-end mono text-white">Rs. @pm.TotalAmount.ToString("N2")</td>
                                <td class="text-end"><span class="badge-pill-modern badge-emerald">@pm.PercentageOfTotal%</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Cashier Performance Leaderboard -->
<div class="glass-card mb-4">
    <div class="glass-card-header">
        <div>
            <h5 class="fw-bold mb-1 text-white">
                <i class="bi bi-trophy-fill text-amber me-2"></i>Cashier Performance & Efficiency Leaderboard
            </h5>
            <p class="text-secondary small mb-0">Speed of checkout, invoice volume, and average basket sizes</p>
        </div>
        <span class="badge-pill-modern badge-indigo">@cashiers.Count Cashiers Active</span>
    </div>
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Cashier Name</th>
                    <th class="text-center">Total Invoices</th>
                    <th class="text-end">Total Sales</th>
                    <th class="text-end">Discounts Given</th>
                    <th class="text-end">Average Basket Value</th>
                </tr>
            </thead>
            <tbody>
                @if (cashiers.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No cashier shifts completed in this date range.</td></tr>
                }
                @foreach (var c in cashiers)
                {
                    <tr>
                        <td class="fw-semibold text-white">
                            <i class="bi bi-person-badge text-secondary me-2"></i>@c.CashierName
                        </td>
                        <td class="text-center">
                            <span class="badge-pill-modern badge-indigo mono">@c.TotalInvoices</span>
                        </td>
                        <td class="text-end text-emerald fw-bold mono">Rs. @c.TotalSalesAmount.ToString("N2")</td>
                        <td class="text-end text-amber mono">Rs. @c.TotalDiscountsGiven.ToString("N2")</td>
                        <td class="text-end text-cyan mono">Rs. @c.AverageBasketValue.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
