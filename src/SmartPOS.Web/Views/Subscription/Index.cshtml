@model List<SmartPOS.Domain.Entities.SaaS.SubscriptionPlan>
@{
    ViewData["Title"] = "Subscription & Quotas - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var business = ViewBag.Business as SmartPOS.Domain.Entities.Organization.Business;
    var currentPlan = ViewBag.CurrentPlan as SmartPOS.Domain.Entities.SaaS.SubscriptionPlan;
    var branchCount = (int)ViewBag.BranchCount;
    var counterCount = (int)ViewBag.CounterCount;
    var productCount = (int)ViewBag.ProductCount;
    var invoices = ViewBag.Invoices as List<SmartPOS.Domain.Entities.SaaS.SubscriptionInvoice> ?? new();
    var currency = business?.CurrencyCode ?? "PKR";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-award text-emerald me-2"></i> SaaS Subscription & Billing</h2>
            <p class="text-muted small mb-0">Monitor active subscription plan, quotas, branch limits, and billing history.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Current Plan & Quota Usage Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-5">
            <div class="card bg-card border-subtle rounded-4 p-4 h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-emerald-subtle text-emerald border border-emerald mb-2">Active Plan</span>
                        <h3 class="fw-bold text-white mb-0">@(currentPlan?.Name ?? "Free Trial Tier")</h3>
                    </div>
                    <div class="fs-4 fw-bold text-emerald mono">
                        @currency @(currentPlan?.MonthlyPrice.ToString("N0") ?? "0") <span class="fs-6 text-muted fw-normal">/mo</span>
                    </div>
                </div>
                <p class="text-muted small mb-4">@(currentPlan?.Description ?? "Evaluation tier for testing multi-branch capabilities.")</p>
                <div class="p-3 rounded bg-surface border border-subtle small mb-3">
                    <div class="text-muted">Status: <span class="text-emerald fw-bold">Active</span></div>
                    <div class="text-muted">Subscription Renewal: <span class="text-light">@(business?.SubscriptionExpiresAtUtc?.ToString("dd MMM yyyy") ?? "In 30 Days")</span></div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card bg-card border-subtle rounded-4 p-4 h-100">
                <h5 class="fw-bold text-light mb-4 pb-2 border-bottom border-subtle">
                    <i class="bi bi-speedometer2 me-2 text-emerald"></i> Quota Consumption
                </h5>
                <!-- Branches Limit -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>Branches Used: <strong>@branchCount</strong> / @(currentPlan?.MaxBranches.ToString() ?? "1") Allowed</span>
                        <span>@((branchCount * 100) / Math.Max(1, currentPlan?.MaxBranches ?? 1))%</span>
                    </div>
                    <div class="progress bg-surface" style="height: 8px;">
                        <div class="progress-bar bg-emerald" style="width: @((branchCount * 100) / Math.Max(1, currentPlan?.MaxBranches ?? 1))%"></div>
                    </div>
                </div>

                <!-- Counters Limit -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>POS Counters Used: <strong>@counterCount</strong> / @(currentPlan?.MaxCounters.ToString() ?? "2") Allowed</span>
                        <span>@((counterCount * 100) / Math.Max(1, currentPlan?.MaxCounters ?? 2))%</span>
                    </div>
                    <div class="progress bg-surface" style="height: 8px;">
                        <div class="progress-bar bg-info" style="width: @((counterCount * 100) / Math.Max(1, currentPlan?.MaxCounters ?? 2))%"></div>
                    </div>
                </div>

                <!-- Products Limit -->
                <div>
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>Catalog Products: <strong>@productCount</strong> / @(currentPlan?.MaxProducts.ToString("N0") ?? "500") Allowed</span>
                        <span>@((productCount * 100) / Math.Max(1, currentPlan?.MaxProducts ?? 500))%</span>
                    </div>
                    <div class="progress bg-surface" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: @((productCount * 100) / Math.Max(1, currentPlan?.MaxProducts ?? 500))%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upgrade / Change Plan Section -->
    <h4 class="fw-bold text-white mb-3">Available Enterprise Upgrade Plans</h4>
    <div class="row g-4 mb-5">
        @foreach (var plan in Model)
        {
            var isCurrent = currentPlan?.Id == plan.Id;
            <div class="col-lg-3 col-md-6">
                <div class="card-stat h-100 p-4 d-flex flex-column position-relative @(isCurrent ? "border-emerald" : "")">
                    @if (isCurrent)
                    {
                        <span class="position-absolute top-0 end-0 bg-emerald text-white px-3 py-1 rounded-bl-3 rounded-tr-3 small fw-bold" style="border-top-right-radius: 12px; border-bottom-left-radius: 12px;">
                            Current Plan
                        </span>
                    }
                    <h5 class="fw-bold text-white mb-1">@plan.Name</h5>
                    <div class="fs-4 fw-bold text-emerald mb-2">
                        @plan.Currency @plan.MonthlyPrice.ToString("N0") <span class="fs-6 text-muted fw-normal">/mo</span>
                    </div>
                    <p class="text-muted small mb-3">@plan.Description</p>
                    <ul class="list-unstyled small text-secondary flex-grow-1 mb-4">
                        <li class="mb-1"><i class="bi bi-check2 text-emerald me-1"></i> @plan.MaxBranches Branches</li>
                        <li class="mb-1"><i class="bi bi-check2 text-emerald me-1"></i> @plan.MaxCounters Counters</li>
                        <li class="mb-1"><i class="bi bi-check2 text-emerald me-1"></i> @plan.MaxUsers Staff Users</li>
                    </ul>
                    @if (isCurrent)
                    {
                        <button class="btn btn-emerald btn-sm w-100 fw-semibold" disabled>Active</button>
                    }
                    else
                    {
                        <form asp-action="ChangePlan" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="planId" value="@plan.Id" />
                            <button type="submit" class="btn btn-outline-light border-subtle btn-sm w-100 fw-semibold" onclick="return confirm('Confirm switching to @plan.Name?');">
                                Switch to @plan.Name
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Invoices History -->
    <h4 class="fw-bold text-white mb-3">Subscription Invoices</h4>
    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!invoices.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No subscription invoices generated yet.</td></tr>
                    }
                    @foreach (var inv in invoices)
                    {
                        <tr>
                            <td><span class="badge bg-surface border border-subtle mono text-light">@inv.InvoiceNo</span></td>
                            <td class="text-muted small">@inv.IssueDateUtc.ToString("dd MMM yyyy")</td>
                            <td class="text-muted small">@inv.DueDateUtc.ToString("dd MMM yyyy")</td>
                            <td class="fw-bold text-emerald mono">@inv.Currency @inv.TotalAmount.ToString("N2")</td>
                            <td><span class="badge bg-emerald-subtle text-emerald border border-emerald">@inv.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
