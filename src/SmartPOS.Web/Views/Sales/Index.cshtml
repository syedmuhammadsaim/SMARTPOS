@model List<SmartPOS.Domain.Entities.Sales.POSOrder>
@{
    ViewData["Title"] = "Sales Transactions & Invoices - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var currency = ViewBag.Currency as string ?? "PKR";
    var totalSales = (decimal)ViewBag.TotalSales;
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-receipt text-emerald me-2"></i> Sales History & Orders</h2>
            <p class="text-muted small mb-0">Browse POS orders, invoice records, customer details, and returns.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="POS" asp-action="Index" class="btn btn-emerald btn-sm px-3 rounded-3 fw-bold">
                <i class="bi bi-cart-check me-1"></i> New Sale
            </a>
            <a asp-controller="Reports" asp-action="ExportSalesCsv" class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3">
                <i class="bi bi-download me-1"></i> Export CSV
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Filters Bar -->
    <div class="card bg-card border-subtle rounded-3 p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-surface border-subtle text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-surface border-subtle text-light" placeholder="Search by invoice # or customer name..." />
                </div>
            </div>
            <div class="col-md-3">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control bg-surface border-subtle text-light" />
            </div>
            <div class="col-md-3">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control bg-surface border-subtle text-light" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-emerald w-100 fw-semibold">Filter</button>
            </div>
        </form>
    </div>

    <!-- Sales Table -->
    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Date & Time</th>
                        <th>Branch</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Subtotal</th>
                        <th>Discount</th>
                        <th>Net Total</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-5">No sales records found for this period.</td></tr>
                    }
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><span class="badge bg-surface border border-subtle mono text-light">@o.InvoiceNo</span></td>
                            <td class="text-muted small">@o.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-secondary small">@(o.Branch?.Name ?? "Main Outlet")</td>
                            <td class="text-light small">@(o.Customer?.Name ?? "Walk-in Customer")</td>
                            <td><span class="badge bg-surface border border-subtle">@o.Items.Count items</span></td>
                            <td class="text-muted small">@currency @o.Subtotal.ToString("N2")</td>
                            <td class="text-muted small">@currency @o.DiscountTotal.ToString("N2")</td>
                            <td class="fw-bold text-emerald mono">@currency @o.Total.ToString("N2")</td>
                            <td>
                                <span class="badge @(o.Status == SmartPOS.Domain.Enums.OrderStatus.Completed ? "bg-emerald-subtle text-emerald border border-emerald" : "bg-warning-subtle text-warning border border-warning")">
                                    @o.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-light border-subtle btn-sm px-2 py-1 rounded" title="View Order Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="POS" asp-action="Receipt" asp-route-orderId="@o.Id" target="_blank" class="btn btn-outline-light border-subtle btn-sm px-2 py-1 rounded" title="Print 80mm Thermal Receipt">
                                    <i class="bi bi-printer text-emerald"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
