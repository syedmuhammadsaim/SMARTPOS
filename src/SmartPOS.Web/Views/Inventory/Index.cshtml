@model List<SmartPOS.Domain.Entities.Inventory.StockBalance>
@{
    ViewData["Title"] = "Inventory & Stock Valuation - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var warehouses = ViewBag.Warehouses as List<SmartPOS.Domain.Entities.Inventory.Warehouse> ?? new();
    var currency = ViewBag.Currency as string ?? "PKR";
    var totalValuation = (decimal)ViewBag.TotalValuation;
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-layers text-emerald me-2"></i> Inventory & Stock Balances</h2>
            <p class="text-muted small mb-0">Multi-warehouse stock levels, inventory valuation, manual adjustments, and transfers.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Transfers" class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3">
                <i class="bi bi-arrow-left-right me-1"></i> Stock Transfers
            </a>
            <button class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
                <i class="bi bi-sliders me-1"></i> Manual Adjustment
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Valuation Banner -->
    <div class="card-stat p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Total Inventory Valuation</span>
                <div class="fs-3 fw-bold text-emerald mono">@currency @totalValuation.ToString("N2")</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-light border-subtle btn-sm px-3 rounded-pill @(ViewBag.LowStockOnly != true ? "active" : "")">All Stock</a>
                <a asp-action="Index" asp-route-lowStockOnly="true" class="btn btn-outline-warning border-subtle btn-sm px-3 rounded-pill @(ViewBag.LowStockOnly == true ? "active" : "")">
                    <i class="bi bi-exclamation-triangle me-1"></i> Low Stock Alerts Only
                </a>
            </div>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Product Item</th>
                        <th>Warehouse / Branch</th>
                        <th>Qty on Hand</th>
                        <th>Min Stock</th>
                        <th>Unit Cost</th>
                        <th>Total Valuation</th>
                        <th>Stock Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">No stock balances recorded.</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        var minStock = s.Product?.MinStock ?? 5m;
                        var valuation = s.QtyOnHand * (s.Product?.PurchasePrice ?? 0m);
                        <tr>
                            <td>
                                <div class="fw-bold text-light">@(s.Product?.Name ?? "Item")</div>
                                <div class="text-muted small mono">SKU: @(s.Product?.Sku ?? "-")</div>
                            </td>
                            <td>
                                <div><span class="badge bg-surface border border-subtle">@(s.Warehouse?.Name ?? "Main Warehouse")</span></div>
                                <div class="text-muted small">@(s.Warehouse?.Branch?.Name ?? "-")</div>
                            </td>
                            <td class="fs-6 fw-bold mono text-light">@s.QtyOnHand.ToString("N0")</td>
                            <td class="text-muted small">@minStock.ToString("N0")</td>
                            <td class="text-muted small">@currency @(s.Product?.PurchasePrice.ToString("N2") ?? "0.00")</td>
                            <td class="fw-bold text-emerald mono">@currency @valuation.ToString("N2")</td>
                            <td>
                                @if (s.QtyOnHand <= 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Out of Stock</span>
                                }
                                else if (s.QtyOnHand <= minStock)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-emerald-subtle text-emerald border border-emerald">Healthy</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Adjust Stock -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Manual Inventory Stock Adjustment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Warehouse</label>
                        <select name="warehouseId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var w in warehouses)
                            {
                                <option value="@w.Id">@w.Name (@(w.Branch?.Name ?? "Main"))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Product</label>
                        <select name="productId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var s in Model.Select(m => m.Product).Where(p => p != null).Distinct())
                            {
                                <option value="@s!.Id">@s.Name (@s.Sku)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Quantity Adjustment (+ to add, - to deduct)</label>
                        <input type="number" step="1" name="qtyAdjustment" class="form-control bg-surface border-subtle text-light mono" placeholder="e.g. +10 or -5" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Reason / Audit Note</label>
                        <input type="text" name="reason" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Physical inventory count discrepancy, damage" required />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Apply Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>
