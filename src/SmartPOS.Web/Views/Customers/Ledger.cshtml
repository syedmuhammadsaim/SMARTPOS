@model SmartPOS.Domain.Entities.Customers.Customer
@{
    ViewData["Title"] = $"Customer Ledger - {Model.Name}";
    Layout = "_Layout";
    var currency = ViewBag.Currency as string ?? "PKR";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Customers</a>
                <span class="text-muted small">/ Ledger</span>
            </div>
            <h2 class="fw-bold text-white mb-0">@Model.Name - Credit Ledger</h2>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="fs-4 fw-bold @(Model.CurrentBalance > 0 ? "text-warning" : "text-emerald") mono">
                Outstanding: @currency @Model.CurrentBalance.ToString("N2")
            </div>
            <button class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#receivePaymentModal">
                <i class="bi bi-cash-coin me-1"></i> Receive Repayment
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Date (UTC)</th>
                        <th>Type</th>
                        <th>Debit (Purchased Udhaar)</th>
                        <th>Credit (Repaid)</th>
                        <th>Running Balance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LedgerEntries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No credit transactions recorded yet.</td></tr>
                    }
                    @foreach (var entry in Model.LedgerEntries.OrderByDescending(e => e.Date))
                    {
                        <tr>
                            <td class="text-muted small">@entry.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-surface border border-subtle">@entry.Type</span></td>
                            <td class="text-warning fw-semibold">@currency @entry.Debit.ToString("N2")</td>
                            <td class="text-emerald fw-semibold">@currency @entry.Credit.ToString("N2")</td>
                            <td class="fw-bold text-light mono">@currency @entry.RunningBalance.ToString("N2")</td>
                            <td class="text-muted small">@(entry.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Receive Payment -->
<div class="modal fade" id="receivePaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Receive Udhaar Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ReceivePayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="p-3 rounded bg-surface border border-subtle mb-3">
                        <span class="text-muted small">Customer:</span>
                        <div class="fw-bold text-light">@Model.Name</div>
                        <div class="text-warning fw-bold mono">Current Balance Due: @currency @Model.CurrentBalance.ToString("N2")</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Payment Amount (@currency)</label>
                        <input type="number" step="0.01" name="amount" class="form-control bg-surface border-subtle text-light mono fs-4 fw-bold" value="@Model.CurrentBalance" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Receipt Remarks</label>
                        <input type="text" name="notes" class="form-control bg-surface border-subtle text-light" placeholder="Cash repayment, receipt slip no" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Confirm Payment Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>
