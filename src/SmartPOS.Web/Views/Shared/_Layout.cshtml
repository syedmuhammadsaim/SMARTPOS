<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMARTPOS Enterprise Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .navbar {
            background-color: #1e293b;
            border-bottom: 1px solid #334155;
        }
        .navbar-brand {
            font-weight: 700;
            color: #38bdf8 !important;
            letter-spacing: 0.5px;
        }
        .nav-link {
            color: #94a3b8 !important;
            font-weight: 500;
            margin-right: 12px;
        }
        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
        }
        .card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #f8fafc;
        }
        .card-header {
            background-color: #0f172a;
            border-bottom: 1px solid #334155;
            font-weight: 600;
        }
        .table {
            color: #f8fafc;
            border-color: #334155;
        }
        .table-dark {
            background-color: #1e293b;
        }
        .metric-card {
            padding: 1.25rem;
            border-radius: 8px;
            background: #1e293b;
            border: 1px solid #334155;
        }
        .metric-value {
            font-size: 1.85rem;
            font-weight: 700;
        }
        .badge-danger { background-color: #ef4444; }
        .badge-warning { background-color: #f59e0b; color: #000; }
        .badge-success { background-color: #10b981; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark px-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-cash-register me-2 text-primary"></i> SMARTPOS <span class="badge bg-primary fs-6">Enterprise v2</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-gauge me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="fa-solid fa-chart-line me-1"></i> Executive Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Alerts" asp-action="Index"><i class="fa-solid fa-bell me-1"></i> Smart Alerts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Inventory"><i class="fa-solid fa-boxes-stacked me-1"></i> Stock Valuation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="ExpiringBatches"><i class="fa-solid fa-calendar-xmark me-1"></i> Expiry &amp; Batches</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="CustomerAgeing"><i class="fa-solid fa-users me-1"></i> Customer Udhaar</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-secondary small">
                        <span class="me-3"><i class="fa-solid fa-building me-1"></i> Main Branch</span>
                        <span class="badge bg-success"><i class="fa-solid fa-shield-halved me-1"></i> FBR Integrated</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4 px-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-secondary py-3 text-center border-top border-secondary small mt-5">
        <div class="container">
            &copy; 2026 - SMARTPOS Enterprise Retail Management System (Pakistan) - Version 2.0.0
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
