@model List<SmartPOS.Application.Features.Customers.DTOs.CustomerAgeingReportDto>
@{
    ViewData["Title"] = "Customer Udhaar Ageing Analysis";
    var totalOutstanding = Model.Sum(x => x.TotalOutstanding);
    var overdue90 = Model.Sum(x => x.Overdue_90Plus);
    var current30 = Model.Sum(x => x.Current_0_30);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-white">Customer Udhaar & Ageing Analysis</h2>
            <span class="badge-pill-modern badge-amber">
                <i class="bi bi-wallet2"></i> Credit Risk Management
            </span>
        </div>
        <p class="text-secondary mb-0">Receivable ageing intervals (0-30, 31-60, 61-90, 90+ days overdue) for credit accounts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Customers" class="btn btn-modern-outline d-inline-flex align-items-center gap-2">
            <i class="bi bi-people"></i> All Customers
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">Total Credit Receivables</div>
            <div class="h3 fw-bold text-amber mono mb-0">Rs. @totalOutstanding.ToString("N2")</div>
            <div class="text-secondary small mt-1">Total outstanding across @Model.Count customer ledgers</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">Active Current (0 - 30 Days)</div>
            <div class="h3 fw-bold text-emerald mono mb-0">Rs. @current30.ToString("N2")</div>
            <div class="text-secondary small mt-1">Normal rolling credit cycle balances</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">High Risk (90+ Days Overdue)</div>
            <div class="h3 fw-bold text-rose mono mb-0">Rs. @overdue90.ToString("N2")</div>
            <div class="text-secondary small mt-1">Requires immediate credit freeze or collections</div>
        </div>
    </div>
</div>

<div class="glass-card">
    <div class="glass-card-header">
        <h5 class="fw-bold mb-0 text-white">Ageing Schedule Ledger</h5>
        <span class="badge-pill-modern badge-indigo">Multi-Bucket Analysis</span>
    </div>
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th class="text-end">0 - 30 Days</th>
                    <th class="text-end">31 - 60 Days</th>
                    <th class="text-end">61 - 90 Days</th>
                    <th class="text-end">90+ Days Overdue</th>
                    <th class="text-end">Total Outstanding</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            <i class="bi bi-check-circle text-emerald fs-3 d-block mb-2"></i>
                            No outstanding credit balances across customer accounts.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-white">@c.CustomerName</div>
                            </td>
                            <td class="text-secondary mono small">@(c.Phone ?? "N/A")</td>
                            <td class="text-end mono text-emerald">Rs. @c.Current_0_30.ToString("N2")</td>
                            <td class="text-end mono text-cyan">Rs. @c.Overdue_31_60.ToString("N2")</td>
                            <td class="text-end mono text-amber">Rs. @c.Overdue_61_90.ToString("N2")</td>
                            <td class="text-end mono">
                                @if (c.Overdue_90Plus > 0)
                                {
                                    <span class="badge-pill-modern badge-rose">Rs. @c.Overdue_90Plus.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Rs. 0.00</span>
                                }
                            </td>
                            <td class="text-end text-amber fw-bold mono fs-6">Rs. @c.TotalOutstanding.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
