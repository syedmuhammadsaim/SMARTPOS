@model List<SmartPOS.Application.Features.Customers.DTOs.CustomerAgeingReportDto>
@{
    ViewData["Title"] = "Customer Udhaar Ageing Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-users text-warning me-2"></i>Customer Udhaar &amp; Ageing Analysis</h2>
        <p class="text-secondary mb-0">Detailed breakdown of customer credit across 30, 60, 90+ days intervals</p>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Customer Ledgers (@Model.Count customers with balance)</span>
        <span class="badge bg-warning text-dark">Total Outstanding: Rs. @Model.Sum(x => x.TotalOutstanding).ToString("N2")</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead class="text-secondary small">
                    <tr>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th class="text-end">0 - 30 Days</th>
                        <th class="text-end">31 - 60 Days</th>
                        <th class="text-end">61 - 90 Days</th>
                        <th class="text-end">90+ Days Overdue</th>
                        <th class="text-end">Total Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">No customer credit balances found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td class="text-secondary small">@(c.Phone ?? "N/A")</td>
                                <td class="text-end text-success">Rs. @c.Current_0_30.ToString("N2")</td>
                                <td class="text-end text-info">Rs. @c.Overdue_31_60.ToString("N2")</td>
                                <td class="text-end text-warning">Rs. @c.Overdue_61_90.ToString("N2")</td>
                                <td class="text-end text-danger fw-bold">Rs. @c.Overdue_90Plus.ToString("N2")</td>
                                <td class="text-end text-warning fw-bold fs-6">Rs. @c.TotalOutstanding.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
