@{
    ViewData["Title"] = "Features - SMARTPOS ENTERPRISE";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-semibold mb-2">Comprehensive SaaS Suite</span>
        <h1 class="fw-bold tracking-tight text-white">Engineered for Modern Enterprise Retail</h1>
        <p class="text-muted lead fs-6 max-w-2xl mx-auto">Explore the deep architectural and operational features that power SMARTPOS ENTERPRISE across branches, counters, and warehouses.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-upc-scan fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">USB HID Barcode Scanner</h5>
                <p class="text-muted small">Instant keystroke listener compatible with all standard USB HID laser and 2D barcode scanners. Zero external drivers required.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-printer fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">Thermal Receipt Generation</h5>
                <p class="text-muted small">Standardized 80mm and 58mm ESC/POS thermal printing with clean layouts, itemized taxes, FBR QR codes, and company logos.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-credit-card fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">Split & Multiple Payments</h5>
                <p class="text-muted small">Accept split payments across Cash, Credit/Debit Cards, Bank Transfers, and Customer Credit (Udhaar) within a single order checkout.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">Multi-Branch Architecture</h5>
                <p class="text-muted small">Each branch maintains independent stock balances, cashier counters, pricing tiers, and daily registers while syncing to central reports.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-box-arrow-left fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">Stock Transfers & Inter-Branch</h5>
                <p class="text-muted small">Dispatch, track, and receive inventory transfers between warehouses and branches with two-step dispatch and receipt confirmation.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card-stat h-100 p-4">
                <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                    <i class="bi bi-shield-lock fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2">Multi-Tenant Isolation</h5>
                <p class="text-muted small">Rigorous logical database isolation with global Entity Framework query filters and verified tenant context resolving from authenticated claims.</p>
            </div>
        </div>
    </div>
</div>
