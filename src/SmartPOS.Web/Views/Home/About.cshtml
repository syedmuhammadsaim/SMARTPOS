@{
    ViewData["Title"] = "About Us - SMARTPOS ENTERPRISE";
}

<div class="container py-5">
    <div class="row align-items-center gy-4 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-semibold mb-2">Our Mission</span>
            <h1 class="fw-bold text-white mb-3">Empowering Retailers with World-Class Cloud POS</h1>
            <p class="text-secondary lead fs-6">
                SMARTPOS ENTERPRISE is built by senior software engineers and retail solution architects to deliver a robust, commercial-grade Point of Sale and ERP platform.
            </p>
            <p class="text-muted small">
                Our architecture solves the real-world operational challenges of multi-branch stores: inventory discrepancies, cashier till shortages, internet connection drops, and complex tax compliance. With logical tenant isolation and high-speed web interfaces, companies operate with total autonomy and centralized visibility.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="card-stat p-4">
                <h5 class="fw-bold text-light mb-3">Core Architectural Pillars</h5>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <span class="p-2 rounded bg-emerald text-white"><i class="bi bi-shield-check fs-5"></i></span>
                    <div>
                        <div class="fw-semibold text-light">Bulletproof Multi-Tenancy</div>
                        <div class="text-muted small">Rigorous logical separation at the database layer with zero data leakage across companies.</div>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <span class="p-2 rounded bg-emerald text-white"><i class="bi bi-lightning-charge fs-5"></i></span>
                    <div>
                        <div class="fw-semibold text-light">Real-Time Performance</div>
                        <div class="text-muted small">Optimized SQL Server indexing, sub-second product lookups, and instant receipt rendering.</div>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <span class="p-2 rounded bg-emerald text-white"><i class="bi bi-check2-all fs-5"></i></span>
                    <div>
                        <div class="fw-semibold text-light">Accounting Integrity</div>
                        <div class="text-muted small">Correct COGS valuation, double-entry ledgers, and exact financial reconciliations.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
