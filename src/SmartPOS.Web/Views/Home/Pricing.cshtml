@model List<SmartPOS.Domain.Entities.SaaS.SubscriptionPlan>
@{
    ViewData["Title"] = "Pricing Plans - SMARTPOS ENTERPRISE";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-semibold mb-2">Transparent Subscription</span>
        <h1 class="fw-bold tracking-tight text-white">Choose the Plan for Your Business</h1>
        <p class="text-muted lead fs-6 max-w-2xl mx-auto">Scalable plans built for individual retail shops, growing retail chains, and enterprise supermarket franchises.</p>
    </div>

    <div class="row g-4 justify-content-center mb-5">
        @foreach (var plan in Model)
        {
            <div class="col-lg-3 col-md-6">
                <div class="card-stat h-100 p-4 d-flex flex-column position-relative @(plan.IsPopular ? "border-emerald" : "")">
                    @if (plan.IsPopular)
                    {
                        <span class="position-absolute top-0 end-0 bg-emerald text-white px-3 py-1 rounded-bl-3 rounded-tr-3 small fw-bold" style="border-top-right-radius: 12px; border-bottom-left-radius: 12px;">
                            Most Popular
                        </span>
                    }
                    <h4 class="fw-bold text-white mb-1">@plan.Name</h4>
                    <p class="text-muted small mb-3">@plan.Description</p>
                    <div class="mb-4">
                        @if (plan.MonthlyPrice == 0)
                        {
                            <span class="display-6 fw-bold text-emerald">Free</span>
                            <span class="text-muted small">/ @plan.TrialDays days</span>
                        }
                        else
                        {
                            <span class="display-6 fw-bold text-emerald">@plan.Currency @plan.MonthlyPrice.ToString("N0")</span>
                            <span class="text-muted small">/ month</span>
                        }
                    </div>
                    <ul class="list-unstyled small text-secondary flex-grow-1 mb-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxBranches</strong> Branches</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxCounters</strong> POS Counters</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxUsers</strong> Staff Users</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxProducts.ToString("N0")</strong> Products</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Thermal Receipt Printing</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Barcode Generation</li>
                        @if (plan.HasAdvancedReports)
                        {
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Advanced P&L Reports</li>
                        }
                        @if (plan.HasFbrIntegration)
                        {
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> FBR Tier-1 Integration</li>
                        }
                    </ul>
                    <a asp-controller="Account" asp-action="Register" asp-route-plan="@plan.Code" class="btn @(plan.IsPopular ? "btn-emerald" : "btn-outline-light border-subtle") w-100 fw-semibold rounded-3 py-2">
                        Get Started with @plan.Name
                    </a>
                </div>
            </div>
        }
    </div>
</div>
