@model SmartPOS.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Executive Retail Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-info me-2"></i>Executive Retail Operations</h2>
        <p class="text-secondary mb-0">Multi-branch enterprise monitoring, real-time sales &amp; stock intelligence</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-dark border border-secondary p-2"><i class="fa-regular fa-clock me-1"></i> Business Date: @DateTime.Now.ToString("dd MMM yyyy")</span>
    </div>
</div>

<!-- TOP 4 METRIC CARDS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-success">
            <div class="text-secondary small fw-bold text-uppercase">Today's Gross Sales</div>
            <div class="metric-value text-success mt-1">Rs. @Model.TodaySales.ToString("N2")</div>
            <div class="text-secondary small mt-1"><i class="fa-solid fa-receipt me-1"></i> @Model.TodayTransactions invoices generated</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-primary">
            <div class="text-secondary small fw-bold text-uppercase">Total Stock Valuation</div>
            <div class="metric-value text-primary mt-1">Rs. @Model.TotalStockValuation.ToString("N2")</div>
            <div class="text-secondary small mt-1"><i class="fa-solid fa-warehouse me-1"></i> Active warehouse inventory</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-warning">
            <div class="text-secondary small fw-bold text-uppercase">Outstanding Customer Udhaar</div>
            <div class="metric-value text-warning mt-1">Rs. @Model.TotalCustomerUdhaar.ToString("N2")</div>
            <div class="text-secondary small mt-1"><i class="fa-solid fa-hand-holding-dollar me-1"></i> Total credit receivables</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-danger">
            <div class="text-secondary small fw-bold text-uppercase">Critical Stock Alerts</div>
            <div class="metric-value text-danger mt-1">@(Model.LowStockAlertsCount + Model.ExpiringBatchesCount)</div>
            <div class="text-secondary small mt-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> @Model.LowStockAlertsCount low stock, @Model.ExpiringBatchesCount expiring</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Expiring Batches Table -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-pills text-danger me-2"></i>Expiring Batches (Within 60 Days - FEFO)</span>
                <a asp-action="ExpiringBatches" class="btn btn-sm btn-outline-info">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead class="text-secondary small">
                            <tr>
                                <th>Product / SKU</th>
                                <th>Batch #</th>
                                <th>Expiry Date</th>
                                <th class="text-end">Days Left</th>
                                <th class="text-end">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ExpiringBatches.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-secondary py-4">No batches expiring in the next 60 days.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var b in Model.ExpiringBatches)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@b.ProductName</div>
                                            <div class="small text-secondary">@b.SKU</div>
                                        </td>
                                        <td><span class="badge bg-dark border border-secondary">@b.BatchNumber</span></td>
                                        <td>@b.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">
                                            @if (b.DaysRemaining <= 15)
                                            {
                                                <span class="badge bg-danger">@b.DaysRemaining d</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@b.DaysRemaining d</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">@b.Quantity.ToString("N0")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Udhaar Receivables -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-user-clock text-warning me-2"></i>Highest Udhaar Receivables</span>
                <a asp-action="CustomerAgeing" class="btn btn-sm btn-outline-warning">Ageing Report</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead class="text-secondary small">
                            <tr>
                                <th>Customer Name</th>
                                <th>Contact</th>
                                <th class="text-end">Outstanding Balance</th>
                                <th class="text-end">Overdue (60+ d)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TopUdhaarCustomers.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-secondary py-4">No customer credit balances found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var c in Model.TopUdhaarCustomers)
                                {
                                    <tr>
                                        <td class="fw-semibold">@c.CustomerName</td>
                                        <td class="text-secondary small">@(c.Phone ?? "N/A")</td>
                                        <td class="text-end text-warning fw-bold">Rs. @c.TotalOutstanding.ToString("N2")</td>
                                        <td class="text-end text-danger">Rs. @(c.Overdue_61_90 + c.Overdue_90Plus).ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
