@model List<SmartPOS.Domain.Entities.SaaS.SubscriptionPlan>
@{
    ViewData["Title"] = "SMARTPOS ENTERPRISE - Multi-Tenant Cloud POS & Business Platform";
}

<!-- Hero Section -->
<section class="py-5 py-lg-6 text-center position-relative overflow-hidden">
    <div class="container position-relative z-1 py-4">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-emerald-subtle border border-emerald mb-3">
            <span class="badge bg-emerald rounded-pill px-2 py-1 text-white" style="font-size: 0.7rem;">v2.0 ENTERPRISE</span>
            <span class="text-emerald small fw-semibold">Next-Gen Multi-Tenant SaaS Point of Sale</span>
        </div>
        <h1 class="display-4 fw-extrabold tracking-tight text-white mb-3 max-w-4xl mx-auto">
            One Platform. Multiple Businesses.<br />
            <span class="text-emerald">Complete Business Control.</span>
        </h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-4 fs-5">
            The enterprise-grade cloud POS and retail ERP designed for modern retail, supermarkets, franchises, and multi-branch operations. Real-time inventory, fast checkout, USB barcode scanning, and shift reconciliation in one single web application.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap mb-5">
            <a asp-controller="Account" asp-action="Register" class="btn btn-emerald btn-lg px-4 py-3 fw-bold rounded-3 shadow">
                <i class="bi bi-rocket-takeoff me-2"></i> Start 14-Day Free Trial
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light border-subtle btn-lg px-4 py-3 fw-semibold rounded-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Access Live Workspace
            </a>
        </div>

        <!-- Metric Badges -->
        <div class="row g-3 justify-content-center max-w-4xl mx-auto text-start">
            <div class="col-md-3 col-6">
                <div class="card-stat p-3">
                    <div class="small text-muted mb-1"><i class="bi bi-shield-check text-emerald me-1"></i> Multi-Tenancy</div>
                    <div class="fs-5 fw-bold text-light">100% Isolated</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-stat p-3">
                    <div class="small text-muted mb-1"><i class="bi bi-upc-scan text-emerald me-1"></i> Scanner Support</div>
                    <div class="fs-5 fw-bold text-light">USB HID Plug & Play</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-stat p-3">
                    <div class="small text-muted mb-1"><i class="bi bi-printer text-emerald me-1"></i> Thermal Receipts</div>
                    <div class="fs-5 fw-bold text-light">80mm & 58mm ESC/POS</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card-stat p-3">
                    <div class="small text-muted mb-1"><i class="bi bi-lightning-charge text-emerald me-1"></i> Framework</div>
                    <div class="fs-5 fw-bold text-light">.NET 10 + SQL Server</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Features Section -->
<section class="py-5 bg-surface border-top border-bottom border-subtle">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h6 class="text-emerald text-uppercase fw-bold letter-spacing-1 small">Platform Capabilities</h6>
            <h2 class="fw-bold text-white">Built for High-Volume Retail & Multi-Branch Networks</h2>
            <p class="text-muted">Everything you need to run, scale, and monitor multiple stores from anywhere in the world.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-cart4 fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">High-Speed Web POS</h5>
                    <p class="text-muted small mb-0">Keyboard-optimized checkout, instant barcode lookup, hold/park cart, multi-payment options (Cash, Card, Bank, Udhaar credit), and instant receipt printing.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-shop fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Multi-Branch & Counters</h5>
                    <p class="text-muted small mb-0">Manage unlimited branches and cashier counters per store. Transfer stock seamlessly between outlets with automated tracking and audit trails.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-boxes fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Batch & Inventory Control</h5>
                    <p class="text-muted small mb-0">Live stock valuation, reorder alerts, low-stock warnings, purchase order receiving, and FEFO expiry tracking for groceries and pharmaceuticals.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-cash-coin fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Shift & Cash Reconciliation</h5>
                    <p class="text-muted small mb-0">Full cashier shifts, opening till cash, cash in/out tracking, mid-shift X-Reports, closing cash difference calculation, and final Z-Reports.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-graph-up-arrow fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Profit & Loss Analytics</h5>
                    <p class="text-muted small mb-0">Real accounting logic separating gross revenue, Cost of Goods Sold (COGS), operational expenses, and net profit with exportable financial reports.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-stat h-100 p-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-emerald-subtle text-emerald mb-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-2">Customer Credit (Udhaar)</h5>
                    <p class="text-muted small mb-0">Complete customer credit ledger, balance ageing (30/60/90 days), partial payments, and automated WhatsApp balance receipts.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section class="py-5" id="pricing">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h6 class="text-emerald text-uppercase fw-bold letter-spacing-1 small">Transparent Plans</h6>
            <h2 class="fw-bold text-white">Simple, Predictable Subscription Pricing</h2>
            <p class="text-muted">Choose the plan that fits your retail scale. Upgrade or downgrade at any time.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var plan in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="card-stat h-100 p-4 d-flex flex-column position-relative @(plan.IsPopular ? "border-emerald" : "")">
                        @if (plan.IsPopular)
                        {
                            <span class="position-absolute top-0 end-0 bg-emerald text-white px-3 py-1 rounded-bl-3 rounded-tr-3 small fw-bold" style="border-top-right-radius: 12px; border-bottom-left-radius: 12px;">
                                Most Popular
                            </span>
                        }
                        <h4 class="fw-bold text-white mb-1">@plan.Name</h4>
                        <p class="text-muted small mb-3">@plan.Description</p>
                        <div class="mb-4">
                            @if (plan.MonthlyPrice == 0)
                            {
                                <span class="display-6 fw-bold text-emerald">Free</span>
                                <span class="text-muted small">/ @plan.TrialDays days</span>
                            }
                            else
                            {
                                <span class="display-6 fw-bold text-emerald">@plan.Currency @plan.MonthlyPrice.ToString("N0")</span>
                                <span class="text-muted small">/ month</span>
                            }
                        </div>
                        <ul class="list-unstyled small text-secondary flex-grow-1 mb-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxBranches</strong> Branches</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxCounters</strong> POS Counters</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxUsers</strong> Staff Users</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Up to <strong>@plan.MaxProducts.ToString("N0")</strong> Products</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Thermal Receipt Printing</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Barcode Generation</li>
                            @if (plan.HasAdvancedReports)
                            {
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> Advanced P&L Reports</li>
                            }
                            @if (plan.HasFbrIntegration)
                            {
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-emerald me-2"></i> FBR Tier-1 Integration</li>
                            }
                        </ul>
                        <a asp-controller="Account" asp-action="Register" asp-route-plan="@plan.Code" class="btn @(plan.IsPopular ? "btn-emerald" : "btn-outline-light border-subtle") w-100 fw-semibold rounded-3 py-2">
                            Select @plan.Name
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 bg-surface border-top border-subtle text-center">
    <div class="container py-4">
        <h2 class="fw-bold text-white mb-3">Ready to Transform Your Retail Business?</h2>
        <p class="text-muted max-w-xl mx-auto mb-4">Register your company in less than 60 seconds and start ringing up sales right from your web browser.</p>
        <a asp-controller="Account" asp-action="Register" class="btn btn-emerald btn-lg px-5 py-3 fw-bold rounded-3 shadow">
            <i class="bi bi-rocket-takeoff me-2"></i> Register Your Company Now
        </a>
    </div>
</section>
