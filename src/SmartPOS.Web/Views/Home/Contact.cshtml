@{
    ViewData["Title"] = "Contact & Support - SMARTPOS ENTERPRISE";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <span class="badge bg-emerald-subtle text-emerald px-3 py-2 rounded-pill fw-semibold mb-2">Get in Touch</span>
                <h1 class="fw-bold text-white mb-2">Contact Our Solutions Team</h1>
                <p class="text-muted">Have questions about multi-branch deployments, hardware compatibility, or custom integrations? We're here to help.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            <div class="card-stat p-4 p-md-5">
                <form asp-action="SubmitContact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Your Name</label>
                            <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="Full Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Business Email</label>
                            <input type="email" name="email" class="form-control bg-surface border-subtle text-light" placeholder="name@company.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Phone Number</label>
                            <input type="tel" name="phone" class="form-control bg-surface border-subtle text-light" placeholder="+92 300 1234567" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Message / Inquiry</label>
                            <textarea name="message" rows="5" class="form-control bg-surface border-subtle text-light" placeholder="Tell us about your business, number of branches, and requirements..." required></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-emerald btn-lg w-100 fw-semibold rounded-3 py-3">
                        <i class="bi bi-send me-2"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
