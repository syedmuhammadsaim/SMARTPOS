@model List<SmartPOS.Application.Features.Inventory.DTOs.ExpiringStockAlertDto>
@{
    ViewData["Title"] = "Batch Expiry Monitoring (FEFO)";
    var criticalCount = Model.Count(b => b.DaysRemaining <= 30);
    var nearCount = Model.Count(b => b.DaysRemaining > 30 && b.DaysRemaining <= 60);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-white">FEFO Batch Expiration Control</h2>
            <span class="badge-pill-modern badge-rose">
                <i class="bi bi-clock-history"></i> First-Expiry-First-Out
            </span>
        </div>
        <p class="text-secondary mb-0">Active stock batches nearing expiration within 90 days across store network</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Inventory" class="btn btn-modern-outline d-inline-flex align-items-center gap-2">
            <i class="bi bi-box-seam"></i> All Inventory
        </a>
        <a asp-controller="Alerts" asp-action="Index" class="btn btn-modern-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-bell-fill"></i> Alerts Hub
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">Critical Expiry (&le; 30 Days)</div>
            <div class="h3 fw-bold text-rose mono mb-0">@criticalCount Batches</div>
            <div class="text-secondary small mt-1">Requires emergency clearance or supplier claim</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">Near Expiry (31 - 60 Days)</div>
            <div class="h3 fw-bold text-amber mono mb-0">@nearCount Batches</div>
            <div class="text-secondary small mt-1">Recommended for frontline promotional bundling</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="glass-card">
            <div class="text-secondary text-uppercase small fw-bold mb-1">Total Tracked Batches</div>
            <div class="h3 fw-bold text-white mono mb-0">@Model.Count Batches</div>
            <div class="text-secondary small mt-1">Monitored in 90-day time window</div>
        </div>
    </div>
</div>

<div class="glass-card">
    <div class="glass-card-header">
        <h5 class="fw-bold mb-0 text-white">Batch Expiry Ledger</h5>
        <span class="badge-pill-modern badge-indigo">FEFO Priority</span>
    </div>
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Product / Medicine</th>
                    <th>SKU</th>
                    <th>Batch Number</th>
                    <th>Warehouse</th>
                    <th>Expiry Date</th>
                    <th class="text-end">Days Remaining</th>
                    <th class="text-end">Stock Balance</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-5">
                            <i class="bi bi-shield-check text-emerald fs-3 d-block mb-2"></i>
                            All active product batches have safe expiry horizons.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-white">@b.ProductName</div>
                            </td>
                            <td><span class="badge-pill-modern badge-indigo mono">@b.SKU</span></td>
                            <td><span class="badge-pill-modern badge-cyan mono">@b.BatchNumber</span></td>
                            <td class="text-secondary">@b.WarehouseName</td>
                            <td class="mono small">@b.ExpiryDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                @if (b.DaysRemaining <= 0)
                                {
                                    <span class="badge-pill-modern badge-rose">EXPIRED</span>
                                }
                                else if (b.DaysRemaining <= 30)
                                {
                                    <span class="badge-pill-modern badge-rose">@b.DaysRemaining Days</span>
                                }
                                else
                                {
                                    <span class="badge-pill-modern badge-amber">@b.DaysRemaining Days</span>
                                }
                            </td>
                            <td class="text-end fw-bold mono text-white">@b.Quantity.ToString("N0")</td>
                            <td class="text-center">
                                <span class="badge-pill-modern badge-indigo" title="Mark for clearance or supplier return">
                                    <i class="bi bi-arrow-return-left"></i> Return / Bundle
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
