@model SmartPOS.Application.Features.Alerts.DTOs.AlertSummaryDto
@{
    ViewData["Title"] = "Smart Stock Alerts & Expiry Control";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-white">Smart Inventory Alerts</h2>
            <span class="badge-pill-modern badge-rose">
                <i class="bi bi-bell-fill"></i> Automated Sentinel
            </span>
        </div>
        <p class="text-secondary mb-0">Safety reorder alerts, multi-tier FEFO expiration tracking, and dead capital identification</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Inventory" class="btn btn-modern-outline d-inline-flex align-items-center gap-2">
            <i class="bi bi-box-seam"></i> Live Inventory
        </a>
    </div>
</div>

<!-- Alert Overview Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary text-uppercase small fw-bold">Low Stock Items</span>
                <div class="kpi-icon-box" style="background: rgba(244, 63, 94, 0.15); color: #F43F5E; border: 1px solid rgba(244, 63, 94, 0.3);">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-rose mono mb-1">@Model.TotalLowStockCount</div>
            <div class="text-secondary small">Below minimum safety threshold</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary text-uppercase small fw-bold">Expired Batches</span>
                <div class="kpi-icon-box" style="background: rgba(244, 63, 94, 0.15); color: #F43F5E; border: 1px solid rgba(244, 63, 94, 0.3);">
                    <i class="bi bi-x-octagon-fill"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-rose mono mb-1">@Model.TotalExpiredCount</div>
            <div class="text-secondary small">Immediate write-off or vendor claim</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary text-uppercase small fw-bold">Expiring in 90 Days</span>
                <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3);">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-amber mono mb-1">@Model.TotalExpiringSoonCount</div>
            <div class="text-secondary small">Prioritize clearance via FEFO</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary text-uppercase small fw-bold">Dead Stock Capital</span>
                <div class="kpi-icon-box" style="background: rgba(22, 133, 107, 0.15); color: #16856B; border: 1px solid rgba(22, 133, 107, 0.3);">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-cyan mono mb-1">Rs. @Model.TotalTiedUpCapitalInDeadStock.ToString("N0")</div>
            <div class="text-secondary small">@Model.TotalDeadStockCount SKUs with no 90-day movement</div>
        </div>
    </div>
</div>

<!-- Low Stock Table -->
<div class="glass-card mb-4">
    <div class="glass-card-header">
        <div>
            <h5 class="fw-bold mb-1 text-white">
                <i class="bi bi-exclamation-triangle-fill text-rose me-2"></i>Low Stock Threshold Warnings
            </h5>
            <p class="text-secondary small mb-0">Items recommended for immediate Purchase Order placement</p>
        </div>
        <span class="badge-pill-modern badge-rose">@Model.LowStockAlerts.Count Warnings</span>
    </div>
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th class="text-center">Current Stock</th>
                    <th class="text-center">Min Threshold</th>
                    <th class="text-end">Suggested Reorder</th>
                    <th>Warehouse</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LowStockAlerts.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">
                            <i class="bi bi-check2-circle text-emerald fs-4 d-block mb-1"></i>
                            All catalog products have healthy stock balances!
                        </td>
                    </tr>
                }
                @foreach (var alert in Model.LowStockAlerts)
                {
                    <tr>
                        <td><span class="badge-pill-modern badge-indigo mono">@alert.Sku</span></td>
                        <td class="fw-semibold text-white">@alert.Name</td>
                        <td class="text-secondary">@alert.CategoryName</td>
                        <td class="text-center"><span class="badge-pill-modern badge-rose mono">@alert.CurrentStock.ToString("0.##")</span></td>
                        <td class="text-center mono text-secondary">@alert.MinStock.ToString("0.##")</td>
                        <td class="text-end text-amber fw-bold mono">+@alert.ReorderSuggestedQty.ToString("0.##")</td>
                        <td class="text-secondary">@alert.WarehouseName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Expiry Warning Batches -->
<div class="glass-card mb-4">
    <div class="glass-card-header">
        <div>
            <h5 class="fw-bold mb-1 text-white">
                <i class="bi bi-calendar2-x text-amber me-2"></i>Near-Expiry & Expired Batches (FEFO Tracking)
            </h5>
            <p class="text-secondary small mb-0">Active batches requiring FEFO prioritization or claim processing</p>
        </div>
        <span class="badge-pill-modern badge-amber">@Model.ExpiryAlerts.Count Tracked Batches</span>
    </div>
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Batch No</th>
                    <th>Product</th>
                    <th class="text-center">Expiry Date</th>
                    <th class="text-center">Days Remaining</th>
                    <th class="text-center">Stock on Hand</th>
                    <th class="text-end">Urgency Level</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ExpiryAlerts.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">
                            <i class="bi bi-shield-check text-emerald fs-4 d-block mb-1"></i>
                            No batches expiring within the 90-day window.
                        </td>
                    </tr>
                }
                @foreach (var exp in Model.ExpiryAlerts)
                {
                    <tr>
                        <td><span class="badge-pill-modern badge-cyan mono">@exp.BatchNo</span></td>
                        <td class="fw-semibold text-white">@exp.Name</td>
                        <td class="text-center mono small">@exp.ExpiryDate.ToString("dd MMM yyyy")</td>
                        <td class="text-center">
                            @if (exp.DaysUntilExpiry <= 0)
                            {
                                <span class="badge-pill-modern badge-rose">EXPIRED</span>
                            }
                            else if (exp.DaysUntilExpiry <= 30)
                            {
                                <span class="badge-pill-modern badge-rose">@exp.DaysUntilExpiry days</span>
                            }
                            else
                            {
                                <span class="badge-pill-modern badge-amber">@exp.DaysUntilExpiry days</span>
                            }
                        </td>
                        <td class="text-center fw-bold mono text-white">@exp.QtyOnHand.ToString("0.##")</td>
                        <td class="text-end">
                            @if (exp.UrgencyLevel == "Expired")
                            {
                                <span class="badge-pill-modern badge-rose">EXPIRED</span>
                            }
                            else if (exp.UrgencyLevel == "Critical30")
                            {
                                <span class="badge-pill-modern badge-rose">CRITICAL (&le; 30d)</span>
                            }
                            else if (exp.UrgencyLevel == "Warning60")
                            {
                                <span class="badge-pill-modern badge-amber">WARNING (&le; 60d)</span>
                            }
                            else
                            {
                                <span class="badge-pill-modern badge-cyan">NOTICE (&le; 90d)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
