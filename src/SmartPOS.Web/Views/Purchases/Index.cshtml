@model List<SmartPOS.Domain.Entities.Purchasing.PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders & Receiving - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var suppliers = ViewBag.Suppliers as List<SmartPOS.Domain.Entities.Purchasing.Supplier> ?? new();
    var branches = ViewBag.Branches as List<SmartPOS.Domain.Entities.Organization.Branch> ?? new();
    var products = ViewBag.Products as List<SmartPOS.Domain.Entities.Catalog.Product> ?? new();
    var currency = ViewBag.Currency as string ?? "PKR";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-bag-check text-emerald me-2"></i> Purchase Orders & Receiving</h2>
            <p class="text-muted small mb-0">Procure inventory from suppliers, receive goods into warehouse stock, and track due balances.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3">
                <i class="bi bi-truck me-1"></i> Suppliers Directory
            </a>
            <button class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#newPurchaseModal">
                <i class="bi bi-plus-lg me-1"></i> New Purchase Order
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>PO #</th>
                        <th>Supplier</th>
                        <th>Branch</th>
                        <th>Items Count</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">No purchase orders created yet.</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><span class="badge bg-surface border border-subtle mono text-light">@p.OrderNo</span></td>
                            <td class="fw-semibold text-light">@(p.Supplier?.Name ?? "Supplier")</td>
                            <td class="text-secondary small">@(p.Warehouse?.Name ?? "Main Warehouse")</td>
                            <td><span class="badge bg-surface border border-subtle">@p.Items.Count Items</span></td>
                            <td class="fw-bold text-light">@currency @p.TotalAmount.ToString("N2")</td>
                            <td><span class="badge bg-emerald-subtle text-emerald border border-emerald">@p.Status</span></td>
                            <td class="text-muted small">@p.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Purchase Order -->
<div class="modal fade" id="newPurchaseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Create Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Supplier</label>
                        <select name="supplierId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id">@s.Name (@s.Phone)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Receiving Branch</label>
                        <select name="branchId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Product to Order</label>
                        <select name="productId" class="form-select bg-surface border-subtle text-light" required>
                            @foreach (var prod in products)
                            {
                                <option value="@prod.Id">@prod.Name (@prod.Sku)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Quantity</label>
                            <input type="number" step="1" name="qty" class="form-control bg-surface border-subtle text-light mono" value="50" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Unit Cost (@currency)</label>
                            <input type="number" step="0.01" name="unitCost" class="form-control bg-surface border-subtle text-light mono" value="100.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Notes</label>
                        <input type="text" name="notes" class="form-control bg-surface border-subtle text-light" placeholder="Supplier invoice ref, delivery remarks" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Confirm PO & Receive Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>
