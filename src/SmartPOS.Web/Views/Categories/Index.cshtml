@model List<SmartPOS.Domain.Entities.Catalog.Category>
@{
    ViewData["Title"] = "Categories, Brands & Units - SMARTPOS ENTERPRISE";
    Layout = "_Layout";
    var brands = ViewBag.Brands as List<SmartPOS.Domain.Entities.Catalog.Brand> ?? new();
    var units = ViewBag.Units as List<SmartPOS.Domain.Entities.Catalog.Unit> ?? new();
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-tags text-emerald me-2"></i> Categories, Brands & Units</h2>
            <p class="text-muted small mb-0">Organize product hierarchy, manufacturing brands, and units of measurement.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-emerald btn-sm px-3 rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                <i class="bi bi-plus-lg me-1"></i> Add Category
            </button>
            <button class="btn btn-outline-light border-subtle btn-sm px-3 rounded-3" data-bs-toggle="modal" data-bs-target="#newBrandModal">
                <i class="bi bi-plus-lg me-1"></i> Add Brand
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <div class="row g-4">
        <!-- Categories Section -->
        <div class="col-lg-5">
            <div class="card bg-card border-subtle rounded-4 overflow-hidden h-100">
                <div class="card-header bg-surface border-subtle py-3 px-4">
                    <h5 class="fw-bold text-light mb-0"><i class="bi bi-folder2-open me-2 text-emerald"></i> Product Categories</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Code</th>
                                <th>Products</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No categories created yet.</td></tr>
                            }
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-light">@c.Name</td>
                                    <td><span class="badge bg-surface border border-subtle mono">@c.Code</span></td>
                                    <td><span class="badge bg-emerald-subtle text-emerald">@c.Products.Count items</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Brands Section -->
        <div class="col-lg-4">
            <div class="card bg-card border-subtle rounded-4 overflow-hidden h-100">
                <div class="card-header bg-surface border-subtle py-3 px-4">
                    <h5 class="fw-bold text-light mb-0"><i class="bi bi-award me-2 text-emerald"></i> Product Brands</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Brand Name</th>
                                <th>Products</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!brands.Any())
                            {
                                <tr><td colspan="2" class="text-center text-muted py-4">No brands created yet.</td></tr>
                            }
                            @foreach (var b in brands)
                            {
                                <tr>
                                    <td class="fw-semibold text-light">@b.Name</td>
                                    <td><span class="badge bg-surface border border-subtle">@b.Products.Count items</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Units Section -->
        <div class="col-lg-3">
            <div class="card bg-card border-subtle rounded-4 overflow-hidden h-100">
                <div class="card-header bg-surface border-subtle py-3 px-4">
                    <h5 class="fw-bold text-light mb-0"><i class="bi bi-rulers me-2 text-emerald"></i> Units</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom mb-0">
                        <thead>
                            <tr>
                                <th>Unit</th>
                                <th>Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in units)
                            {
                                <tr>
                                    <td class="text-light">@u.Name</td>
                                    <td><span class="badge bg-surface border border-subtle mono">@u.ShortCode</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Category -->
<div class="modal fade" id="newCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Create Product Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Category Name</label>
                        <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Frozen Foods" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Short Code</label>
                        <input type="text" name="code" class="form-control bg-surface border-subtle text-light mono" placeholder="e.g. FRZ" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Description</label>
                        <textarea name="description" class="form-control bg-surface border-subtle text-light" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: New Brand -->
<div class="modal fade" id="newBrandModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-subtle text-light">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold">Create Brand</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateBrand" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Brand Name</label>
                        <input type="text" name="name" class="form-control bg-surface border-subtle text-light" placeholder="e.g. Unilever" required />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-outline-light border-subtle" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald fw-semibold">Save Brand</button>
                </div>
            </form>
        </div>
    </div>
</div>
