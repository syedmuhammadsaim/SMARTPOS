@model SmartPOS.Domain.Entities.Purchasing.Supplier
@{
    ViewData["Title"] = $"Supplier Ledger - {Model.Name}";
    Layout = "_Layout";
    var currency = ViewBag.Currency as string ?? "PKR";
}

<div class="container-fluid px-md-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left"></i> Suppliers</a>
                <span class="text-muted small">/ Ledger</span>
            </div>
            <h2 class="fw-bold text-white mb-0">@Model.Name - Payable Ledger</h2>
        </div>
        <div class="fs-4 fw-bold text-warning mono">
            Current Balance: @currency @Model.CurrentBalance.ToString("N2")
        </div>
    </div>

    <div class="card bg-card border-subtle rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Date (UTC)</th>
                        <th>Type</th>
                        <th>Debit (Paid)</th>
                        <th>Credit (Purchased)</th>
                        <th>Running Balance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LedgerEntries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">No ledger transactions recorded yet.</td></tr>
                    }
                    @foreach (var entry in Model.LedgerEntries.OrderByDescending(e => e.Date))
                    {
                        <tr>
                            <td class="text-muted small">@entry.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-surface border border-subtle">@entry.Type</span></td>
                            <td class="text-emerald fw-semibold">@currency @entry.Debit.ToString("N2")</td>
                            <td class="text-warning fw-semibold">@currency @entry.Credit.ToString("N2")</td>
                            <td class="fw-bold text-light mono">@currency @entry.RunningBalance.ToString("N2")</td>
                            <td class="text-muted small">@(entry.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
