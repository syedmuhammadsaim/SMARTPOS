<Window x:Class="SmartPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartPOS.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="SMARTPOS Enterprise - High-Speed Checkout"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainPosViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Flat Modern Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="PayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="QuickCashButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" /> <!-- Top Header -->
            <RowDefinition Height="*" />  <!-- Billing Body -->
            <RowDefinition Height="36" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="SP" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding AppTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="17" />
                        <TextBlock Text="ENTERPRISE RETAIL &amp; PHARMACY POS" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Session Context -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="6,0">
                        <TextBlock Text="{Binding BranchName}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="6,0">
                        <TextBlock Text="{Binding CounterName}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="6,0">
                        <TextBlock Text="{Binding CashierName}" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="6,0">
                        <TextBlock Text="{Binding BusinessDate}" Foreground="#FDE047" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Controls, Hardware & Offline Indicators -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding PendingOfflineOrdersCount, StringFormat='Offline: {0} 🔄'}" 
                            Command="{Binding SyncOfflineCommand}" 
                            Background="#D97706" 
                            Foreground="#FFFFFF"
                            FontSize="12"
                            Margin="4,0"
                            Padding="10,6"
                            ToolTip="Click to synchronize offline transactions with the cloud server" />

                    <Button Content="📺 Display" 
                            Command="{Binding OpenCustomerDisplayCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Margin="4,0"
                            Padding="10,6"
                            ToolTip="Open Customer Display Screen on 2nd monitor" />

                    <Button Content="🔍 Kiosk" 
                            Command="{Binding OpenPriceCheckerCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Margin="4,0"
                            Padding="10,6"
                            ToolTip="Open Price Checker Kiosk mode" />

                    <Button Content="↩️ Returns" 
                            Command="{Binding OpenReturnDialogCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Margin="4,0"
                            Padding="10,6"
                            ToolTip="Open Sale Return &amp; Refund window" />

                    <Button Content="{Binding IsUrdu, Converter={x:Null}, FallbackValue='اردو / EN'}" 
                            Command="{Binding ToggleLanguageCommand}" 
                            Style="{StaticResource ActionButton}" 
                            Margin="4,0"
                            Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BILLING AREA -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" /> <!-- Left: Scanner + Cart -->
                <ColumnDefinition Width="16" />  <!-- Separator -->
                <ColumnDefinition Width="4*" /> <!-- Right: Customer + Totals + Tender -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: CART & SCANNING -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barcode Input Box -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="8" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBarcode" 
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" 
                                 Foreground="#F8FAFC" 
                                 CaretBrush="#38BDF8"
                                 FontSize="16" 
                                 BorderThickness="0" 
                                 VerticalAlignment="Center" 
                                 Padding="8,4"
                                 KeyDown="TxtBarcode_KeyDown" />
                        <Button Grid.Column="1" 
                                Content="SCAN / ADD" 
                                Command="{Binding ScanCommand}" 
                                Background="#2563EB" 
                                Padding="16,8" 
                                Margin="4,0,0,0" />
                    </Grid>
                </Border>

                <!-- Cart Items DataGrid -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="4">
                    <DataGrid ItemsSource="{Binding CartItems}" 
                              SelectedItem="{Binding SelectedCartItem}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              Background="Transparent" 
                              RowBackground="#1E293B" 
                              AlternatingRowBackground="#0F172A"
                              Foreground="#F8FAFC" 
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column"
                              FontSize="14">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM / SKU" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                            <DataGridTextColumn Header="UNIT" Binding="{Binding UnitName}" Width="0.8*" IsReadOnly="True" />
                            <DataGridTextColumn Header="PRICE" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="QTY" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Width="24" Height="24" Padding="0" Margin="2,0"
                                                    Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" />
                                            <Button Content="+" Width="24" Height="24" Padding="0" Margin="2,0"
                                                    Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DISC%" Binding="{Binding DiscountPercent, StringFormat='{}{0:N0}%'}" Width="0.8*" IsReadOnly="True" />
                            <DataGridTextColumn Header="TAX" Binding="{Binding LineTax, StringFormat='Rs. {0:N2}'}" Width="1.1*" IsReadOnly="True" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="1.3*" FontWeight="Bold" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Width="24" Height="24" Padding="0" 
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Bottom Action Key Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Hold Bill (F2)" Command="{Binding HoldBillCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0" />
                    <Button Content="Clear Cart (F3)" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                    <Button Content="Mid-Shift X-Report (F4)" Command="{Binding XReportCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0" />
                    <Button Content="Close Shift Z-Report (F5)" Command="{Binding ZReportCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0" />
                </StackPanel>
            </Grid>

            <!-- RIGHT: CUSTOMER & TENDER SUMMARY -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Customer Selection -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER / ACCOUNT" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Customers}" 
                                  SelectedItem="{Binding SelectedCustomer}" 
                                  DisplayMemberPath="Name"
                                  Background="#0F172A" 
                                  Foreground="#F8FAFC" 
                                  FontSize="14" 
                                  Padding="6" />
                    </StackPanel>
                </Border>

                <!-- Financial Calculation Card -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Subtotal -->
                        <Grid Grid.Row="0" Margin="0,4">
                            <TextBlock Text="Subtotal:" Foreground="#94A3B8" FontSize="14" />
                            <TextBlock Text="{Binding Subtotal, StringFormat='Rs. {0:N2}'}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Discount -->
                        <Grid Grid.Row="1" Margin="0,4">
                            <TextBlock Text="Total Discount:" Foreground="#94A3B8" FontSize="14" />
                            <TextBlock Text="{Binding TotalDiscount, StringFormat='-Rs. {0:N2}'}" Foreground="#F87171" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- GST Tax -->
                        <Grid Grid.Row="2" Margin="0,4">
                            <TextBlock Text="Sales Tax (GST):" Foreground="#94A3B8" FontSize="14" />
                            <TextBlock Text="{Binding TotalTax, StringFormat='Rs. {0:N2}'}" Foreground="#FCD34D" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Grid.Row="3" Background="#334155" Margin="0,10" />

                        <!-- GRAND TOTAL DISPLAY -->
                        <Border Grid.Row="4" Background="#0F172A" CornerRadius="8" Padding="14" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalLabel}" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding GrandTotal, StringFormat='Rs. {0:N2}'}" Foreground="#10B981" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- TENDER & CHANGE -->
                        <StackPanel Grid.Row="5" Margin="0,14,0,0">
                            <!-- Quick Cash Buttons -->
                            <TextBlock Text="QUICK TENDER (PKR):" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Button Content="EXACT" Command="{Binding ExactCashCommand}" Style="{StaticResource QuickCashButton}" />
                                <Button Content="Rs. 500" Command="{Binding QuickCashCommand}" CommandParameter="500" Style="{StaticResource QuickCashButton}" />
                                <Button Content="Rs. 1,000" Command="{Binding QuickCashCommand}" CommandParameter="1000" Style="{StaticResource QuickCashButton}" />
                                <Button Content="Rs. 5,000" Command="{Binding QuickCashCommand}" CommandParameter="5000" Style="{StaticResource QuickCashButton}" />
                            </UniformGrid>

                            <Grid Margin="0,4">
                                <TextBlock Text="Tendered Amount:" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" />
                                <TextBox Text="{Binding TenderedAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                                         Background="#0F172A" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" 
                                         Width="120" HorizontalAlignment="Right" Padding="6,4" BorderBrush="#334155" />
                            </Grid>

                            <Grid Margin="0,6">
                                <TextBlock Text="Change Due:" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ChangeDue, StringFormat='Rs. {0:N2}'}" Foreground="#FDE047" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BIG PAY BUTTON -->
                <Button Grid.Row="2" 
                        Content="{Binding PayButtonText}" 
                        Command="{Binding SettleCashCommand}" 
                        Style="{StaticResource PayButton}" 
                        Margin="0,12,0,0" />
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" />
                <TextBlock Grid.Column="1" Text="FBR POS INTEGRATION READY | SECURE V2 ENGINE" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
