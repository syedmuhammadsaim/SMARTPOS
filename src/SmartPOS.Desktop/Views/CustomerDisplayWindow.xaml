<Window x:Class="SmartPOS.Desktop.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartPOS.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Customer Display - SMARTPOS"
        Height="768" Width="1024"
        WindowStartupLocation="Manual"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,2" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SMARTPOS ENTERPRISE" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="Welcome! خوش آمدید • Premium Retail Experience" FontSize="14" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CashierName, StringFormat='Cashier: {0}'}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BranchName, StringFormat='Branch: {0}'}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns (Cart Items + Live Total Card) -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Cart Table -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Your Cart Items" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CartItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#1E293B"
                              AlternatingRowBackground="#243248"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              Foreground="#F8FAFC"
                              FontSize="15"
                              RowHeight="42">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="70" />
                            <DataGridTextColumn Header="RATE (RS)" Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Width="100" />
                            <DataGridTextColumn Header="DISC" Binding="{Binding LineDiscount, StringFormat='{}{0:N2}'}" Width="80" />
                            <DataGridTextColumn Header="TOTAL (RS)" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Live Summary Card -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Payment Summary" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                    <!-- Last Scanned Banner -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="14" Margin="0,0,0,20" BorderBrush="#38BDF8" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LAST SCANNED ITEM:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="{Binding SelectedCartItem.Name, FallbackValue='Awaiting next scan...'}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedCartItem.LineTotal, StringFormat='Rs. {0:N2}', FallbackValue='Rs. 0.00'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Breakdown -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <Grid Margin="0,4">
                            <TextBlock Text="Subtotal:" FontSize="15" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding Subtotal, StringFormat='Rs. {0:N2}'}" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Total Savings:" FontSize="15" Foreground="#10B981" />
                            <TextBlock Text="{Binding TotalDiscount, StringFormat='-Rs. {0:N2}'}" FontSize="15" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Sales Tax (GST):" FontSize="15" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding TaxTotal, StringFormat='Rs. {0:N2}'}" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Grand Total Big Badge -->
                    <Border Grid.Row="4" Background="#10B981" CornerRadius="8" Padding="18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AMOUNT PAYABLE" FontSize="14" FontWeight="Bold" Foreground="#ECFDF5" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GrandTotal, StringFormat='Rs. {0:N2}'}" FontSize="38" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Ticker -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,0">
            <TextBlock Text="FBR Integrated Point of Sale • Verified Digitally • Please collect your computerized receipt"
                       FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
