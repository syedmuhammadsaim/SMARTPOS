<Window x:Class="SmartPOS.Desktop.Views.PriceCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Price Checker Kiosk - SMARTPOS"
        Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kiosk Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,0,0,30">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SMARTPOS PRICE CHECKER" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="قیمت معلوم کرنے کا کیوسک • Scan any item barcode to check price and stock" FontSize="16" Foreground="#94A3B8" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Hidden / auto-focused Barcode Entry Box -->
                <TextBox x:Name="TxtBarcode" Width="1" Height="1" Opacity="0" KeyDown="TxtBarcode_KeyDown" LostFocus="TxtBarcode_LostFocus" />
            </Grid>
        </Border>

        <!-- Main Display Panel -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" Padding="40" BorderBrush="#334155" BorderThickness="2">
            <!-- Initial Prompt (When no item is scanned) -->
            <Grid>
                <StackPanel x:Name="PnlPrompt" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📷" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <TextBlock Text="Please Scan an Item Barcode" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="برائے مہربانی پروڈکٹ کا بارکوڈ اسکینر کے سامنے رکھیں" FontSize="22" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Scanned Result Panel -->
                <Grid x:Name="PnlResult" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtProductName" Text="Sample Product Name" FontSize="36" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtProductCategory" Text="Category: Grocery | SKU: SKU-1002" FontSize="18" Foreground="#94A3B8" Margin="0,8,0,24" />

                    <!-- Price Card -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="12" Padding="30" VerticalAlignment="Center" BorderBrush="#10B981" BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RETAIL PRICE / ریٹیل قیمت" FontSize="16" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtPrice" Text="Rs. 450.00" FontSize="54" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,6,0,0" />
                                <TextBlock x:Name="TxtStockStatus" Text="✔ In Stock • دستیاب ہے" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,10,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="20" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="GST INCLUDED" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" />
                                    <TextBlock Text="ٹیکس شامل ہے" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Auto-reset timer countdown -->
                    <TextBlock Grid.Row="3" x:Name="TxtResetTimer" Text="Screen resets in 8 seconds..." FontSize="14" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,16,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- Kiosk Footer -->
        <TextBlock Grid.Row="2" Text="Press ESC or Close to return to POS checkout" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0" />
    </Grid>
</Window>
