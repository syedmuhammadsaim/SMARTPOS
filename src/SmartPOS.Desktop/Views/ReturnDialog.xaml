<Window x:Class="SmartPOS.Desktop.Views.ReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMARTPOS - Sale Return &amp; Refund" Height="600" Width="850"
        WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sale Return &amp; Restock" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <TextBlock Text=" - Scan or enter original invoice number" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtInvoiceNo" Height="40" Background="#1E293B" Foreground="#FFFFFF"
                     BorderBrush="#38BDF8" BorderThickness="1.5" FontSize="16" Padding="10,6"
                     VerticalContentAlignment="Center" KeyDown="TxtInvoiceNo_KeyDown"/>
            <Button Grid.Column="1" Content="Lookup Invoice" Width="140" Margin="10,0,0,0" Height="40"
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                    Click="BtnLookup_Click"/>
        </Grid>

        <!-- Order Items DataGrid -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="10">
            <DataGrid x:Name="DgReturnItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" Foreground="#F8FAFC" RowBackground="#1E293B"
                      AlternatingRowBackground="#0F172A" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=Rs. {0:N2}}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Billed Qty" Binding="{Binding OriginalQty}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Eligible" Binding="{Binding EligibleQty}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Return Qty" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Background="#334155" Foreground="#FFFFFF" Padding="4" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Condition" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding Condition}" SelectedValuePath="Tag" Background="#334155" Foreground="#000000">
                                    <ComboBoxItem Content="Restockable" Tag="Restockable" IsSelected="True"/>
                                    <ComboBoxItem Content="Damaged" Tag="Damaged"/>
                                    <ComboBoxItem Content="Expired" Tag="Expired"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Refund Info & Method -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,15,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Refund Method: " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                    <ComboBox x:Name="CmbRefundMethod" Width="140" Height="32" Margin="10,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Cash" Tag="Cash"/>
                        <ComboBoxItem Content="Customer Ledger" Tag="CustomerLedger"/>
                        <ComboBoxItem Content="Store Credit" Tag="StoreCredit"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Reason: " VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                    <TextBox x:Name="TxtReason" Width="200" Height="32" Margin="10,0,0,0" Text="Customer return" Background="#334155" Foreground="#FFFFFF" Padding="6,4"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Estimated Refund: " FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblRefundTotal" Text="Rs. 0.00" FontWeight="Bold" FontSize="18" Foreground="#4ADE80" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Calculate Refund" Width="150" Height="42" Background="#0284C7" Foreground="#FFFFFF"
                    FontWeight="Bold" FontSize="14" Margin="0,0,10,0" Click="BtnCalculate_Click"/>
            <Button Content="Confirm Return &amp; Refund" Width="200" Height="42" Background="#16A34A" Foreground="#FFFFFF"
                    FontWeight="Bold" FontSize="14" Margin="0,0,10,0" Click="BtnConfirmReturn_Click"/>
            <Button Content="Close" Width="100" Height="42" Background="#475569" Foreground="#FFFFFF"
                    FontWeight="Bold" FontSize="14" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
